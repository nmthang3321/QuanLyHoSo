<Window x:Class="QuanLyHoSo.Server.ServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hồ sơ - Máy chủ"
        Width="780" Height="480" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/QuanLyHoSo.Server;component/Assets/AppIcon.ico"
        Background="#F4F7FB" FontFamily="Segoe UI"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B5CFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#16213E" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE5F1" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#174A84" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#174A84" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#103A68" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#103A68" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B2D52" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0B2D52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#C8D4E6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF4FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9DB7DC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE9FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CopyIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#C8D9F1" />
            <Setter Property="Foreground" Value="#174A84" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#082B66">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUẢN LÝ HỒ SƠ" Foreground="White" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Máy chủ nội bộ" Foreground="#BDD4F8" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#143F7C" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="9" Height="9" Fill="#37D67A" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="Đang hoạt động" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN MÁY CHỦ" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="13" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Địa chỉ kết nối" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="ClientUrlText" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource CopyIconButton}" Margin="10,5,0,5"
                                    ToolTip="Sao chép địa chỉ kết nối" Click="CopyUrl_Click">
                                <TextBlock Text="&#xE14D;" FontSize="18" Foreground="#174A84"
                                           FontFamily="pack://application:,,,/Assets/Fonts/#Material Symbols Outlined" />
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Tên máy" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="MachineNameText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Text="Thời gian chạy" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="UptimeText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="3" Text="Client đang kết nối" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectedClientsText" Grid.Row="3" Grid.Column="1" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ĐIỀU KHIỂN" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="13" />
                    <Button x:Name="ToggleServerButton" Content="Dừng máy chủ" Style="{StaticResource PrimaryButton}" Margin="0,16,0,9" Click="ToggleServer_Click" />
                    <Button Content="Sao lưu ngay" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" Click="Backup_Click" />
                    <Button Content="Mở thư mục dữ liệu" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" Click="OpenDataFolder_Click" />
                    <Button Content="Mở thư mục log" Style="{StaticResource SecondaryButton}" Margin="0,0,0,9" Click="OpenLogFolder_Click" />
                    <Button Content="Thoát máy chủ" Foreground="#C62828" Style="{StaticResource SecondaryButton}" Click="Exit_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock Margin="24,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Đóng hoặc thu nhỏ cửa sổ sẽ đưa máy chủ xuống khay hệ thống." />
        </Border>
    </Grid>
</Window>
