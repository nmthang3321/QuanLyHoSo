<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net5.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="5.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="QuanLyHoSo.Core\QuanLyHoSo.Core.csproj" />
    <ProjectReference Include="QuanLyHoSo.Shared\QuanLyHoSo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Infrastructure\Configuration\*.cs" />
    <Compile Remove="Infrastructure\Data\*.cs" />
    <Compile Remove="Infrastructure\Documents\*.cs" />
    <Compile Remove="Infrastructure\Logging\*.cs" />
    <Compile Remove="Infrastructure\Network\*.cs" />
    <Compile Remove="Infrastructure\Security\*.cs" />
    <Compile Remove="Models\AuthModels.cs" />
    <Compile Remove="Models\AreaSelectionModels.cs" />
    <Compile Remove="Models\DashboardModels.cs" />
    <Compile Remove="Models\RecordModels.cs" />
    <Compile Remove="Models\SettingsModels.cs" />
    <Compile Remove="Models\StaffTrackingModels.cs" />
    <Compile Remove="QuanLyHoSo.Core\**\*.cs" />
    <Compile Remove="QuanLyHoSo.Shared\**\*.cs" />
    <Compile Remove="QuanLyHoSo.Server\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="doc\phieu_de_xuat.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="doc\phieu_huong_dan.docx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="doc\thong_bao.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <None Remove="Assets\AppIcon.png" />
    <None Remove="Assets\Fonts\MaterialSymbolsOutlined.ttf" />
    <None Remove="Assets\icons8-id-card-80.png" />
    <None Remove="Assets\LoginBackground.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\Fonts\MaterialSymbolsOutlined.ttf" />
    <Resource Include="Assets\icons8-id-card-80.png" />
    <Resource Include="Assets\LoginBackground.png" />
  </ItemGroup>

</Project>
