<Application x:Class="QuanLyHoSo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QuanLyHoSo.Presentation.Converters"
             xmlns:dashboard="clr-namespace:QuanLyHoSo.Views.Dashboard"
             xmlns:export="clr-namespace:QuanLyHoSo.Views.Export"
             xmlns:records="clr-namespace:QuanLyHoSo.Views.Records"
             xmlns:settings="clr-namespace:QuanLyHoSo.Views.Settings"
             xmlns:viewModels="clr-namespace:QuanLyHoSo.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:BooleanToNavBrushConverter x:Key="BooleanToNavBrushConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:StatusDonutSegmentConverter x:Key="StatusDonutSegmentConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Color x:Key="PrimaryColor">#0B5CFF</Color>
        <Color x:Key="PrimaryDarkColor">#062A63</Color>
        <Color x:Key="TextColor">#06164A</Color>
        <Color x:Key="MutedTextColor">#5C6B91</Color>
        <Color x:Key="LineColor">#D8E2F3</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="AppBackgroundColor">#F5F8FC</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#E11414" />
            <Setter Property="BorderBrush" Value="#FFB8B8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF1F8" />
            <Setter Property="VerticalGridLinesBrush" Value="#ECF1F8" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#F2F6FC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
        </Style>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecordInputViewModel}">
            <records:RecordInputView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecordListViewModel}">
            <records:RecordListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecordProcessingViewModel}">
            <records:RecordProcessingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ExportViewModel}">
            <export:ExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
