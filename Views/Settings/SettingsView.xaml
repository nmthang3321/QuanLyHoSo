<UserControl x:Class="QuanLyHoSo.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontWeight="Medium">
    <UserControl.Resources>
        <Style x:Key="SettingsPageTitleText" TargetType="TextBlock" BasedOn="{StaticResource PageTitleText}" />

        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="PopupIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="UserActionIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F0F6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E4EEFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5E2F3" />
        </Style>

        <Style x:Key="AdminOnlyCardBorder" TargetType="Border" BasedOn="{StaticResource SettingsCardBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanEditSettings}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionItemBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E4F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#EDF4FF" />
                    <Setter Property="BorderBrush" Value="#8CB1FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CatalogCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E9F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#F8FBFF" />
                    <Setter Property="BorderBrush" Value="#9DBBFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="CÀI ĐẶT" Style="{StaticResource SettingsPageTitleText}" />
                    <TextBlock Text="Quản lý danh mục, thông tin phần mềm và nhật ký hệ thống"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Style="{StaticResource AdminOnlyCardBorder}"
                                Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="DANH MỤC HỆ THỐNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Quản lý các danh mục sử dụng trong hệ thống"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,18" />

                                <ItemsControl ItemsSource="{Binding CatalogGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenCatalogDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CatalogCardButton}">
                                                <Border Style="{StaticResource CatalogCardBorder}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border Width="58"
                                                                Height="58"
                                                                CornerRadius="29"
                                                                Background="{Binding IconBackground}"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{Binding AccentColor}"
                                                                       FontSize="28"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding AccentColor}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <Border Background="#F2F6FC" BorderBrush="#D6E2F4" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="12" FontWeight="Bold" Foreground="{Binding AccentColor}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Description}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MinHeight="42"
                                                                   Margin="0,12,0,0" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SettingsCardBorder}">
                                    <Setter Property="Grid.Row" Value="2" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditSettings}" Value="False">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Margin" Value="0,0,6,12" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#0B5CFF" CornerRadius="3" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#EAF2FF">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0B5CFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="THAO TÁC NHANH" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="Các tiện ích dành cho tài khoản của bạn" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <Button Command="{Binding OpenSystemLogDialogCommand}" Style="{StaticResource CatalogCardButton}">
                                        <Border Style="{StaticResource QuickActionItemBorder}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Nhật ký hệ thống" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Theo dõi thêm, sửa, xóa và cập nhật dữ liệu" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding OpenChangePasswordDialogCommand}" Style="{StaticResource CatalogCardButton}">
                                        <Border Style="{StaticResource QuickActionItemBorder}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Đổi mật khẩu" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Cập nhật mật khẩu cho tài khoản hiện tại" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding OpenUserManagementDialogCommand}"
                                            Style="{StaticResource CatalogCardButton}"
                                            Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Style="{StaticResource QuickActionItemBorder}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Người dùng &amp; phân quyền" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Quản lý admin, cán bộ và lãnh đạo" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingsCardBorder}"
                                Margin="6,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#0B5CFF" CornerRadius="3" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#EAF2FF">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0B5CFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="THÔNG TIN PHẦN MỀM" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="Thông tin phiên bản và môi trường đang sử dụng" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SoftwareInfos}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FBFF" BorderBrush="#E0EAF7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="156" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SettingsCardBorder}">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Margin" Value="6,0,0,12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditSettings}" Value="False">
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#18A66A" CornerRadius="3" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#E7F8F0">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#13885A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="CẬP NHẬT PHẦN MỀM" Style="{StaticResource SectionTitleText}" Foreground="#13885A" />
                                        <TextBlock Text="Kiểm tra và cài đặt phiên bản mới" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="#F1FBF6" BorderBrush="#CDEEDF" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                </Border>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Phiên bản hiện tại" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                </Grid>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CheckUpdateCommand}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Kiểm tra cập nhật" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UpdateSoftwareCommand}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Cập nhật" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource AdminOnlyCardBorder}"
                                Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F28C18" CornerRadius="3" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#FFF1DF">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#D96F00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="SAO LƯU DỮ LIỆU" Style="{StaticResource SectionTitleText}" Foreground="#B85E00" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Lưu bản sao về máy hiện tại hoặc chọn file để khôi phục dữ liệu trên server"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="Thư mục lưu bản sao"
                                           Style="{StaticResource SettingsLabel}"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackupFolder, Mode=OneWay}"
                                             IsReadOnly="True"
                                             ToolTip="{Binding BackupFolder}"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource CompactIconButton}"
                                            Command="{Binding ChooseBackupFolderCommand}"
                                            ToolTip="Chọn thư mục lưu bản sao"
                                            Margin="8,0,0,0">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#EAF2FF">
                                            <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="960" Height="960">
                                                    <Path Data="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h207q16 0 30.5 6t25.5 17l57 57h360q17 0 28.5 11.5T880-680q0 17-11.5 28.5T840-640H447l-80-80H160v480l79-263q8-26 29.5-41.5T316-560h516q41 0 64.5 32.5T909-457l-72 240q-8 26-29.5 41.5T760-160H160Zm84-80h516l72-240H316l-72 240Zm-84-262v-218 218Zm84 262 72-240-72 240Z"
                                                          Fill="#0B5CFF">
                                                        <Path.RenderTransform>
                                                            <TranslateTransform Y="960" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Button>
                                </Grid>

                                <TextBlock Text="File dùng để khôi phục"
                                           Style="{StaticResource SettingsLabel}"
                                           Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding RestoreFilePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             ToolTip="{Binding RestoreFilePath}"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource CompactIconButton}"
                                            Command="{Binding ChooseRestoreFileCommand}"
                                            ToolTip="Chọn file sao lưu để khôi phục"
                                            Margin="8,0,0,0">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#FFF1DF">
                                            <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid Width="960" Height="960">
                                                    <Path Data="M388-530q17-18 41-29t51-11q54 0 92 38t38 92q0 54-38 92t-92 38q-36 0-65.5-18T368-375q-6-11-17.5-14.5T328-388q-12 5-16.5 17.5T314-347q24 44 68 70.5t98 26.5q78 0 134-56t56-134q0-78-56-134t-134-56q-38 0-71 14t-59 38v-32q0-13-8.5-21.5T320-640q-13 0-21.5 8.5T290-610v110q0 13 8.5 21.5T320-470h110q13 0 21.5-8.5T460-500q0-13-8.5-21.5T430-530h-42ZM240-80q-33 0-56.5-23.5T160-160v-640q0-33 23.5-56.5T240-880h287q16 0 30.5 6t25.5 17l194 194q11 11 17 25.5t6 30.5v447q0 33-23.5 56.5T720-80H240Zm0-80h480v-446L526-800H240v640Zm0 0v-640 640Z"
                                                          Fill="#D96F00">
                                                        <Path.RenderTransform>
                                                            <TranslateTransform Y="960" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Button>
                                </Grid>

                                <Border Background="#F8FAFE" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Lần sao lưu gần nhất" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BackupStatus}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                                            <TextBlock Text="Sao lưu ngay" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RestoreDataCommand}"
                                            BorderBrush="#D96F00"
                                            Padding="20,0"
                                            Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Foreground="#B85E00" Margin="0,0,8,0" />
                                            <TextBlock Text="Khôi phục dữ liệu" Foreground="#B85E00" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#6606164A" Visibility="{Binding IsCatalogDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="760" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding CatalogDialogTitle}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Thêm, chỉnh sửa hoặc xóa danh mục đang sử dụng" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" Command="{Binding CloseCatalogDialogCommand}" ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <TextBlock Text="Danh mục hiện tại" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CatalogValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="116" Command="{Binding SaveCatalogValueCommand}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CatalogSubmitButtonText}" Foreground="White" />
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="94"
                                    Command="{Binding CancelCatalogEditCommand}"
                                    Visibility="{Binding IsEditingCatalogValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Hủy sửa" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="CatalogValuesListBox"
                             Grid.Row="2"
                             ItemsSource="{Binding CatalogValues}"
                             SelectedItem="{Binding SelectedCatalogValue, Mode=TwoWay}"
                             Height="286"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="CatalogValuesListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CatalogValuesListBox_PreviewMouseMove"
                             DragOver="CatalogValuesListBox_DragOver"
                             Drop="CatalogValuesListBox_Drop"
                             BorderBrush="#E1E9F5"
                             BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ECF1F8" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE700;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Kéo để đổi thứ tự" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayOrder}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PopupIconButton}"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    Command="{Binding DataContext.SelectCatalogValueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Chọn để chỉnh sửa">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                            <Button Style="{StaticResource PopupIconButton}"
                                                    Foreground="#E11414"
                                                    Command="{Binding DataContext.DeleteCatalogValueForRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Xóa">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{Binding CatalogRowsText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Kéo từng dòng để đổi thứ tự hiển thị"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding CloseCatalogDialogCommand}">
                            <TextBlock Text="Đóng" Foreground="White" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsSystemLogDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="920" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="NHẬT KÝ HỆ THỐNG" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding SystemLogScopeText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshSystemLogsCommand}"
                                    Padding="18,0"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Làm mới" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PopupIconButton}"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Command="{Binding CloseSystemLogDialogCommand}"
                                    ToolTip="Đóng">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Margin="0,14,0,0"
                              ItemsSource="{Binding SystemLogs}"
                              Height="420"
                              FontWeight="Normal"
                              IsReadOnly="True"
                              FrozenColumnCount="3"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserSortColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="54" />
                            <DataGridTextColumn Header="Ngày giờ" Binding="{Binding CreatedAt}" Width="142" />
                            <DataGridTextColumn Header="Người dùng" Binding="{Binding UserName}" Width="110" />
                            <DataGridTextColumn Header="Phân hệ" Binding="{Binding Module}" Width="120" />
                            <DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="92" />
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding Target}" Width="320" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Detail}" Width="620" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsChangePasswordDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="430" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ĐỔI MẬT KHẨU" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Cập nhật mật khẩu cho tài khoản hiện tại"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource MutedTextBrush}"
                                Command="{Binding CloseChangePasswordDialogCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CurrentPasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Mật khẩu mới" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding NewPasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ConfirmNewPasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding ChangePasswordStatus}"
                                   Foreground="#E11414"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Command="{Binding CloseChangePasswordDialogCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ChangePasswordCommand}">
                            <TextBlock Text="Đổi mật khẩu" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsUserManagementDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="10" Width="980" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="NGƯỜI DÙNG &amp; PHÂN QUYỀN" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Quản lý tài khoản, vai trò và trạng thái truy cập hệ thống"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource MutedTextBrush}"
                                Command="{Binding CloseUserManagementDialogCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.7*" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Danh sách tài khoản" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UserSummaryText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                      Height="390"
                                      FontWeight="Normal"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CanUserSortColumns="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="All"
                                      VerticalGridLinesBrush="#ECF1F8"
                                      RowHeight="42">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Chọn để xem và chỉnh sửa tài khoản" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Foreground" Value="#8A94A6" />
                                                <Setter Property="Background" Value="#F4F6F8" />
                                                <Setter Property="Opacity" Value="0.68" />
                                                <Setter Property="ToolTip" Value="Tài khoản đã khóa — chọn để mở khóa hoặc xem thông tin" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding UserName}" Width="135" />
                                    <DataGridTextColumn Header="Họ tên" Binding="{Binding DisplayName}" Width="*" MinWidth="155" />
                                    <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="95" />
                                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border MinWidth="92"
                                                        Height="24"
                                                        Padding="9,0"
                                                        CornerRadius="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EAF8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#E8EBEF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Đang hoạt động" />
                                                                <Setter Property="Foreground" Value="#16813B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="Đã khóa" />
                                                                        <Setter Property="Foreground" Value="#687386" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Border Grid.Column="1" Background="#F8FAFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Thông tin tài khoản" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding SelectedUserStatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,16" />

                                <TextBlock Text="Tài khoản" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding UserNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Tên cán bộ" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding UserProcessorNames}"
                                          SelectedItem="{Binding UserDisplayNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          Margin="0,0,0,4" />
                                <TextBlock Text="Danh sách lấy từ Danh mục hệ thống › Tên cán bộ xử lý"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="Vai trò" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding UserRoles}" SelectedItem="{Binding SelectedUserRole, Mode=TwoWay}" Margin="0,0,0,12" />

                                <TextBlock Text="Mật khẩu" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding UserPasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding UserPasswordHintText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveUserCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding UserSubmitButtonText}" Foreground="White" />
                                </Button>
                                <Button Content="Tạo mới" Style="{StaticResource SecondaryButton}" Command="{Binding NewUserCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <Button Command="{Binding ToggleUserStatusCommand}"
                                        CommandParameter="{Binding SelectedUser}"
                                        HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Height" Value="36" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                            <Setter Property="BorderBrush" Value="#7FA7F8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="#E11414" />
                                                    <Setter Property="BorderBrush" Value="#F3A5A5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding UserStatusActionText}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Admin: toàn quyền  •  Lãnh đạo: chỉ xem  •  Cán bộ: xử lý hồ sơ được phân công"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <Button Grid.Row="2"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseUserManagementDialogCommand}">
                        <TextBlock Text="Đóng" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
