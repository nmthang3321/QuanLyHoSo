<UserControl x:Class="QuanLyHoSo.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PopupIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CatalogCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E9F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#F8FBFF" />
                    <Setter Property="BorderBrush" Value="#9DBBFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="CÀI ĐẶT" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Quản lý danh mục, thông tin phần mềm và nhật ký hệ thống"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.95*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,12">
                            <StackPanel>
                                <TextBlock Text="DANH MỤC HỆ THỐNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Quản lý các danh mục sử dụng trong hệ thống"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,18" />

                                <ItemsControl ItemsSource="{Binding CatalogGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenCatalogDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CatalogCardButton}">
                                                <Border Style="{StaticResource CatalogCardBorder}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border Width="58"
                                                                Height="58"
                                                                CornerRadius="29"
                                                                Background="{Binding IconBackground}"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       Foreground="{Binding AccentColor}"
                                                                       FontSize="28"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding AccentColor}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <Border Background="#F2F6FC" BorderBrush="#D6E2F4" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="12" FontWeight="Bold" Foreground="{Binding AccentColor}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Description}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MinHeight="42"
                                                                   Margin="0,12,0,0" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="THAO TÁC NHANH" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Các thao tác quản trị hệ thống" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
                                <StackPanel>
                                    <Button Command="{Binding OpenSystemLogDialogCommand}" Style="{StaticResource CatalogCardButton}">
                                        <Border BorderBrush="#E1E9F5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Nhật ký hệ thống" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Theo dõi thêm, sửa, xóa và cập nhật dữ liệu" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding OpenUserManagementDialogCommand}"
                                            Style="{StaticResource CatalogCardButton}"
                                            Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border BorderBrush="#E1E9F5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Người dùng &amp; phân quyền" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Quản lý admin, cán bộ và lãnh đạo" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding OpenGuideDialogCommand}" Style="{StaticResource CatalogCardButton}">
                                        <Border BorderBrush="#E1E9F5" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Hướng dẫn" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Xem nhanh cách dùng các phần cài đặt" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="THÔNG TIN PHẦN MỀM" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SoftwareInfos}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#ECF1F8" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="156" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="CẬP NHẬT PHẦN MỀM" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Phiên bản hiện tại" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                </Grid>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CheckUpdateCommand}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Kiểm tra cập nhật" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UpdateSoftwareCommand}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Cập nhật" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="SAO LƯU DỮ LIỆU" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Tạo bản sao cơ sở dữ liệu trên máy server" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <Border Background="#F8FAFE" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Lần sao lưu gần nhất" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding LastBackupText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BackupStatus}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Sao lưu ngay" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#6606164A" Visibility="{Binding IsCatalogDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="760" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding CatalogDialogTitle}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Thêm, chỉnh sửa hoặc xóa danh mục đang sử dụng" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" Command="{Binding CloseCatalogDialogCommand}" ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <TextBlock Text="Danh mục hiện tại" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CatalogValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="116" Command="{Binding SaveCatalogValueCommand}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CatalogSubmitButtonText}" Foreground="White" />
                            </Button>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="94"
                                    Command="{Binding CancelCatalogEditCommand}"
                                    Visibility="{Binding IsEditingCatalogValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Hủy sửa" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="CatalogValuesListBox"
                             Grid.Row="2"
                             ItemsSource="{Binding CatalogValues}"
                             SelectedItem="{Binding SelectedCatalogValue, Mode=TwoWay}"
                             Height="286"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="CatalogValuesListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="CatalogValuesListBox_PreviewMouseMove"
                             DragOver="CatalogValuesListBox_DragOver"
                             Drop="CatalogValuesListBox_Drop"
                             BorderBrush="#E1E9F5"
                             BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ECF1F8" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE700;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Kéo để đổi thứ tự" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayOrder}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PopupIconButton}"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    Command="{Binding DataContext.SelectCatalogValueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Chọn để chỉnh sửa">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                            <Button Style="{StaticResource PopupIconButton}"
                                                    Foreground="#E11414"
                                                    Command="{Binding DataContext.DeleteCatalogValueForRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Xóa">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{Binding CatalogRowsText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Kéo từng dòng để đổi thứ tự hiển thị"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Button Content="Đóng" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding CloseCatalogDialogCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsGuideDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="680" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="HƯỚNG DẪN CÀI ĐẶT" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Các thao tác quản trị nhanh trong trang cài đặt"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource MutedTextBrush}"
                                Command="{Binding CloseGuideDialogCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="Danh mục hệ thống" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Rê chuột để xem nổi bật, click vào card để thêm mới, sửa hoặc xóa giá trị danh mục."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,14" />

                        <TextBlock Text="Nhật ký hệ thống" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Theo dõi các thao tác thêm, sửa, xóa danh mục, hồ sơ và cập nhật xử lý."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Đóng"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0"
                            Command="{Binding CloseGuideDialogCommand}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsSystemLogDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="920" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="NHẬT KÝ HỆ THỐNG" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Ghi nhận các thao tác thêm, sửa, xóa và cập nhật dữ liệu"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource MutedTextBrush}"
                                Command="{Binding CloseSystemLogDialogCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshSystemLogsCommand}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Làm mới" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SystemLogs}"
                              Height="420"
                              IsReadOnly="True"
                              CanUserSortColumns="False"
                              CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="54" />
                            <DataGridTextColumn Header="Ngày giờ" Binding="{Binding CreatedAt}" Width="142" />
                            <DataGridTextColumn Header="Người dùng" Binding="{Binding UserName}" Width="110" />
                            <DataGridTextColumn Header="Phân hệ" Binding="{Binding Module}" Width="120" />
                            <DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="92" />
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding Target}" Width="150" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Detail}" Width="*" MinWidth="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Background="#6606164A" Visibility="{Binding IsUserManagementDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#CBD8EA" BorderThickness="1" CornerRadius="6" Width="940" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="NGƯỜI DÙNG &amp; PHÂN QUYỀN" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Admin toàn quyền, lãnh đạo chỉ xem, cán bộ chỉ thao tác hồ sơ đứng dưới tên mình"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PopupIconButton}"
                                HorizontalAlignment="Right"
                                Foreground="{StaticResource MutedTextBrush}"
                                Command="{Binding CloseUserManagementDialogCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  Height="360"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserSortColumns="False"
                                  CanUserResizeRows="False"
                                  Margin="0,0,14,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding UserName}" Width="140" />
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding DisplayName}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="100" />
                                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="82" />
                                <DataGridTemplateColumn Header="Thao tác" Width="86">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource PopupIconButton}"
                                                        Foreground="{StaticResource PrimaryBrush}"
                                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Sửa">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                                <Button Style="{StaticResource PopupIconButton}"
                                                        Foreground="#E11414"
                                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Khóa">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" Background="#F8FAFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Tài khoản" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding UserNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Họ tên / tên cán bộ" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding UserDisplayNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Vai trò" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding UserRoles}" SelectedItem="{Binding SelectedUserRole, Mode=TwoWay}" Margin="0,0,0,12" />

                                <TextBlock Text="Mật khẩu" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding UserPasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <CheckBox Content="Tài khoản đang hoạt động"
                                          IsChecked="{Binding IsUserActive, Mode=TwoWay}"
                                          Margin="0,0,0,18" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveUserCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding UserSubmitButtonText}" Foreground="White" />
                                </Button>
                                <Button Content="Tạo mới" Style="{StaticResource SecondaryButton}" Command="{Binding NewUserCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <Button Content="Khóa tài khoản"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteUserCommand}"
                                        CommandParameter="{Binding SelectedUser}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2"
                            Content="Đóng"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseUserManagementDialogCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

