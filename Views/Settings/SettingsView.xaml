<UserControl x:Class="QuanLyHoSo.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="CÀI ĐẶT" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Quản lý cấu hình và dữ liệu phần mềm" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#EAF2FF" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="76,4,0,0">
                                <TextBlock Text="Danh mục địa bàn" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Quản lý danh sách địa bàn của tỉnh An Giang từ SQLite" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AreaActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECF1F8" BorderThickness="0,1,0,0" Padding="0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding AccentColor}" FontSize="16" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#EAF8EF" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#1FA24A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="76,4,0,0">
                                <TextBlock Text="Danh mục nghiệp vụ" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Quản lý danh mục phục vụ nhập liệu và xử lý hồ sơ" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CatalogActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECF1F8" BorderThickness="0,1,0,0" Padding="0,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding AccentColor}" FontSize="16" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#FFF5DA" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#D18A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="76,4,0,0">
                                <TextBlock Text="Sao lưu dữ liệu" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Sao lưu và khôi phục dữ liệu để đảm bảo an toàn thông tin" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Lần sao lưu gần nhất" />
                            <TextBlock Text="25/08/2026 21:30" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Thư mục sao lưu" />
                            <TextBlock Text="%LocalAppData%\QuanLyHoSo" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <Button Style="{StaticResource SecondaryButton}" Content="Sao lưu ngay" HorizontalAlignment="Left" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Khôi phục dữ liệu" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#F2EAFE" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#7147D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="76,4,0,0">
                                <TextBlock Text="Thông tin phần mềm" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Thông tin về phần mềm và đơn vị sử dụng" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SoftwareInfos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#ECF1F8" BorderThickness="0,1,0,0" Padding="0,13">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

