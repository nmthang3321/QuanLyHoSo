<UserControl x:Class="QuanLyHoSo.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="CatalogGroupButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatalogGroupBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFE" />
            <Setter Property="BorderBrush" Value="#E6EDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="CÀI ĐẶT" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Quản lý danh mục nghiệp vụ, sao lưu dữ liệu và cập nhật phần mềm"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#EAF8EF"
                        BorderBrush="#B9E8C6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" Foreground="#1FA24A" Margin="0,0,8,0" />
                        <TextBlock Text="Địa bàn An Giang đang dùng danh mục cố định" Foreground="#20693A" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DANH MỤC NGHIỆP VỤ" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Các trường chọn trong form nhập, phân loại, lọc và xuất dữ liệu"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#F2F6FC"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <TextBlock Text="{Binding SelectedCatalogGroup.Title, StringFormat=Đang chọn: {0}}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CatalogGroups}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectCatalogGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CatalogGroupButton}">
                                        <Border Style="{StaticResource CatalogGroupBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{Binding AccentColor}"
                                                           FontSize="18"
                                                           VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Background="White"
                                                        BorderBrush="#E1E9F5"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        VerticalAlignment="Top"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F2F6FC" Padding="12,9" CornerRadius="6,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="STT" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="Giá trị hiển thị" FontWeight="Bold" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="CatalogValuesListBox"
                                         Grid.Row="1"
                                         ItemsSource="{Binding CatalogValues}"
                                         SelectedItem="{Binding SelectedCatalogValue, Mode=TwoWay}"
                                         AllowDrop="True"
                                         BorderThickness="0"
                                         MinHeight="230"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseLeftButtonDown="CatalogValuesListBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="CatalogValuesListBox_PreviewMouseMove"
                                         DragOver="CatalogValuesListBox_DragOver"
                                         Drop="CatalogValuesListBox_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#ECF1F8" BorderThickness="0,0,0,1" Padding="8,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayOrder}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="&#xE700;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tên giá trị" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding CatalogValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="320" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddCatalogValueCommand}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Thêm mới" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UpdateCatalogValueCommand}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                        <TextBlock Text="Chỉnh sửa" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteCatalogValueCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                        <TextBlock Text="Xóa" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Border Width="46" Height="46" CornerRadius="6" Background="#FFF5DA" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="#D18A00"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="60,0,0,0">
                                    <TextBlock Text="SAO LƯU DỮ LIỆU" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Chọn thư mục và tạo bản sao lưu SQLite"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Thư mục sao lưu" Style="{StaticResource SettingsLabel}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource CompactIconButton}"
                                        Command="{Binding ChooseBackupFolderCommand}"
                                        Content="&#xE8B7;"
                                        Margin="6,0,0,0"
                                        ToolTip="Chọn thư mục sao lưu" />
                            </Grid>

                            <Border Background="#F8FAFE" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Lần sao lưu gần nhất" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding LastBackupText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock Text="{Binding BackupStatus}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding BackupNowCommand}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Sao lưu ngay" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RestoreDataCommand}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                        <TextBlock Text="Khôi phục" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Border Width="46" Height="46" CornerRadius="6" Background="#EAF2FF" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="60,0,0,0">
                                    <TextBlock Text="THÔNG TIN PHẦN MỀM" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Phiên bản, dữ liệu local và cập nhật"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SoftwareInfos}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#ECF1F8" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#F8FAFE" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
                            </Border>

                            <Grid>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CheckUpdateCommand}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                        <TextBlock Text="Check update" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding UpdateSoftwareCommand}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Cập nhật" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
