<UserControl x:Class="QuanLyHoSo.Views.Records.StaffTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DateFilterMenuItem" TargetType="MenuItem">
            <EventSetter Event="Click" Handler="DateFilterMenuItem_Click" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="MetricCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TinyPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="700" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="THEO DÕI XỬ LÝ CÁN BỘ" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Theo dõi tiến độ, deadline và hiệu suất xử lý hồ sơ của từng cán bộ"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Right">
                    <Button x:Name="DateFilterHost"
                            Style="{StaticResource SecondaryButton}"
                            Width="312"
                            Height="38"
                            Click="DateFilterButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.DateFilterOptions, RelativeSource={RelativeSource Self}}"
                                             MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                             Placement="Bottom"
                                             ItemContainerStyle="{StaticResource DateFilterMenuItem}" />
                            </Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DateRangeText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                              </Button>

                              <Popup x:Name="CustomDateRangePopup"
                                  IsOpen="{Binding IsCustomCalendarOpen, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=DateFilterHost}"
                                  Placement="Bottom"
                                  StaysOpen="False"
                                  AllowsTransparency="True"
                                  PopupAnimation="Fade"
                                  Opened="CustomDateRangePopup_Opened">
                            <Border Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,6,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="4"
                                                      Opacity="0.16"
                                                      Color="#06164A" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Button Content="Áp dụng"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                MinWidth="86"
                                                Click="ApplyCustomDateRangeButton_Click" />
                                    </Grid>
                                    <Calendar x:Name="CustomDateRangeCalendar"
                                              SelectionMode="SingleRange"
                                              PreviewMouseLeftButtonDown="CustomDateRangeCalendar_PreviewMouseLeftButtonDown" />
                                </StackPanel>
                            </Border>
                    </Popup>
                </Grid>
            </Grid>

            <Grid x:Name="LeftContentPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Stretch" MinHeight="{Binding ActualHeight, ElementName=RightInfoCard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Metrics}" Margin="-6,0,-6,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MetricCardButton}"
                                    Command="{Binding DataContext.SelectMetricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="6,0">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Background" Value="#F8FAFD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="8" Background="{Binding BackgroundColor}">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="25"
                                                       Foreground="{Binding AccentColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="27"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,3" />
                                            <TextBlock Text="{Binding Note}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HIỆU SUẤT XỬ LÝ CỦA CÁN BỘ"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="16,14,16,10" />
                        <DataGrid ItemsSource="{Binding StaffRows}"
                                  SelectedItem="{Binding SelectedStaff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeight="43"
                                  Height="337"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2FF" />
                                            <Setter Property="BorderBrush" Value="#7EA8FF" />
                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2FF" />
                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Cán bộ" Width="1.6*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="#EAF2FF" BorderBrush="#CADCFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Position}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Được giao" Binding="{Binding AssignedCount}" Width="0.7*" />
                                <DataGridTextColumn Header="Đang xử lý" Binding="{Binding ProcessingCount}" Width="0.75*" />
                                <DataGridTextColumn Header="Hoàn thành" Binding="{Binding CompletedCount}" Width="0.75*" />
                                <DataGridTextColumn Header="Sắp hạn" Binding="{Binding DueSoonCount}" Width="0.65*" />
                                <DataGridTextColumn Header="Quá hạn" Binding="{Binding OverdueCount}" Width="0.65*" />
                                <DataGridTemplateColumn Header="Tỷ lệ đúng hạn" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OnTimeRateText}"
                                                       Foreground="{Binding OnTimeRateColor}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="KPI" Width="1.05*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KpiPercent, StringFormat={}{0}%}" FontSize="12" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1"
                                                             Height="7"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding KpiPercent}"
                                                             Foreground="#35C47B"
                                                             Background="#E9EEF6"
                                                             VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="1.0*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding KpiStatusBackground}"
                                                    CornerRadius="10"
                                                    Height="22"
                                                    Padding="10,0"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding KpiStatus}"
                                                           Style="{StaticResource TinyPillText}"
                                                           Foreground="{Binding KpiStatusForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="16,10,16,12">
                            <TextBlock Text="{Binding StaffRowsSummaryText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding PreviousStaffPageCommand}"
                                        ToolTip="Trang trước">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Border Background="#F8FAFD"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="36"
                                        MinWidth="92"
                                        Margin="8,0"
                                        Padding="14,0">
                                    <TextBlock Text="{Binding StaffPageText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding NextStaffPageCommand}"
                                        ToolTip="Trang sau">
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="HIỆU SUẤT XỬ LÝ THEO CÁN BỘ" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Ellipse Width="8" Height="8" Fill="#0B5CFF" VerticalAlignment="Center" />
                                <TextBlock Text="Tỷ lệ đúng hạn (%)" FontSize="12" Margin="6,0,18,0" />
                                <Ellipse Width="8" Height="8" Fill="#35C47B" VerticalAlignment="Center" />
                                <TextBlock Text="KPI (%)" FontSize="12" Margin="6,0,0,0" />
                            </StackPanel>
                            <Grid Height="170">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="#ECF1F8" BorderThickness="0,1,0,1" />
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding BarStats}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Grid Height="132" Width="44">
                                                    <Border Width="16"
                                                            Height="{Binding OnTimeHeight}"
                                                            Background="#0B5CFF"
                                                            CornerRadius="4,4,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom" />
                                                    <Border Width="16"
                                                            Height="{Binding KpiHeight}"
                                                            Background="#35C47B"
                                                            CornerRadius="4,4,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding BarStats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StaffName}"
                                                       FontSize="11"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StaffName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="TÌNH TRẠNG DEADLINE" Style="{StaticResource SectionTitleText}" />
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="132" Height="132" Stretch="Uniform">
                                    <Grid Width="190" Height="190">
                                        <Ellipse Stroke="#ECF1F8" StrokeThickness="26" Fill="#F8FAFD" />
                                        <ItemsControl ItemsSource="{Binding DeadlineStats}"
                                                      Width="190"
                                                      Height="190">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Converter={StaticResource StatusDonutSegmentConverter}}"
                                                          Stroke="{Binding Color}"
                                                          StrokeThickness="26"
                                                          StrokeStartLineCap="Flat"
                                                          StrokeEndLineCap="Flat" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Ellipse Width="104" Height="104" Fill="White" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalDeadlineRecordsText}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Hồ sơ" FontSize="12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding DeadlineStats}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Count, StringFormat={}{0:N0}}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="Dữ liệu cập nhật đến 03/09/2026 09:30"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="RightInfoCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Thông tin cán bộ" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>

                    <Border Width="74" Height="74" CornerRadius="37" Background="#EAF2FF" HorizontalAlignment="Center" Margin="0,2,0,10">
                        <TextBlock Text="{Binding SelectedStaff.Initials}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding SelectedStaff.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedStaff.Position}"
                               Style="{StaticResource MutedText}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <Border Background="#EAF2FF" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" Margin="0,6,0,18">
                        <TextBlock Text="Phòng Tiếp nhận và Xử lý"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold" />
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hồ sơ được giao" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedStaff.AssignedCount}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Đang xử lý" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStaff.ProcessingCount}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Đã hoàn thành" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStaff.CompletedCount}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="Tỷ lệ đúng hạn" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedStaff.OnTimeRateText}" Foreground="#0FA958" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Text="Thời gian xử lý TB" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedStaff.AverageProcessingTimeText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="KPI tháng 09/2026" FontWeight="Bold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Chỉ tiêu đặt ra" />
                                <TextBlock Text="{Binding LeadershipKpiTargetText, StringFormat={}{0} hồ sơ}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Đã hoàn thành" />
                                <TextBlock Text="{Binding SelectedStaffCompletionText}" Foreground="#0FA958" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tiến độ" />
                                <TextBlock Text="{Binding SelectedStaffTargetProgressText}" Foreground="#0FA958" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding SelectedStaffTargetProgressPercent, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" Background="#E9EEF6" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Visibility="{Binding CanSendLeadershipNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="GỬI THÔNG BÁO CHO CÁN BỘ" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />

                            <TextBlock Text="Phạm vi thông báo" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding LeadershipScopes}"
                                      SelectedItem="{Binding SelectedLeadershipScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10" />

                            <TextBlock Text="Chỉ tiêu hồ sơ" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding LeadershipKpiTargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Nội dung thông báo" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                            <TextBox Height="86"
                                     Text="{Binding LeadershipNoticeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Margin="0,0,0,12" />

                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveLeadershipDirectiveCommand}" HorizontalAlignment="Stretch" Padding="8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                                    <TextBlock Text="Gửi thông báo" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding LeadershipActionStatus}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Visibility="{Binding CanReadLeadershipNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="THÔNG BÁO TỪ LÃNH ĐẠO" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                            <Border Background="#F8FAFD" BorderBrush="#DDE7F5" BorderThickness="1" CornerRadius="6" Padding="10">
                                <TextBlock Text="{Binding LeadershipNoticeText}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"
                                           LineHeight="20" />
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LeadershipActionStatus}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
