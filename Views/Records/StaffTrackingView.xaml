<UserControl x:Class="QuanLyHoSo.Views.Records.StaffTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DateFilterMenuItem" TargetType="MenuItem">
            <EventSetter Event="Click" Handler="DateFilterMenuItem_Click" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="MetricCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="TinyPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="700" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="THEO DÕI XỬ LÝ CÁN BỘ" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Theo dõi tiến độ, deadline và hiệu suất xử lý hồ sơ của từng cán bộ"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Right">
                    <Button x:Name="DateFilterHost"
                            Style="{StaticResource SecondaryButton}"
                            Width="312"
                            Height="38"
                            Click="DateFilterButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.DateFilterOptions, RelativeSource={RelativeSource Self}}"
                                             MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                             Placement="Bottom"
                                             ItemContainerStyle="{StaticResource DateFilterMenuItem}" />
                            </Button.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DateRangeText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                              </Button>

                              <Popup x:Name="CustomDateRangePopup"
                                  IsOpen="{Binding IsCustomCalendarOpen, Mode=TwoWay}"
                                  PlacementTarget="{Binding ElementName=DateFilterHost}"
                                  Placement="Bottom"
                                  StaysOpen="False"
                                  AllowsTransparency="True"
                                  PopupAnimation="Fade"
                                  Opened="CustomDateRangePopup_Opened">
                            <Border Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,6,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="4"
                                                      Opacity="0.16"
                                                      Color="#06164A" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Button Content="Áp dụng"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                MinWidth="86"
                                                Click="ApplyCustomDateRangeButton_Click" />
                                    </Grid>
                                    <Calendar x:Name="CustomDateRangeCalendar"
                                              SelectionMode="SingleRange"
                                              PreviewMouseLeftButtonDown="CustomDateRangeCalendar_PreviewMouseLeftButtonDown" />
                                </StackPanel>
                            </Border>
                    </Popup>
                </Grid>
            </Grid>

            <Grid x:Name="LeftContentPanel"
                  Grid.Row="1"
                  Grid.Column="0"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Metrics}" Margin="-6,0,-6,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MetricCardButton}"
                                    Command="{Binding DataContext.SelectMetricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="6,0">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Background" Value="#F8FAFD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="23"
                                                Background="{Binding AccentColor}">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding AccentColor}" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Margin="0,6,0,4" />
                                            <TextBlock Text="{Binding Note}"
                                                       FontSize="12"
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="HIỆU SUẤT XỬ LÝ CỦA CÁN BỘ"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="16,14,16,10" />
                        <DataGrid ItemsSource="{Binding StaffRows}"
                                  SelectedItem="{Binding SelectedStaff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeight="43"
                                  Height="252"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  CanUserAddRows="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2FF" />
                                            <Setter Property="BorderBrush" Value="#7EA8FF" />
                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2FF" />
                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Cán bộ" Width="1.6*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="#EAF2FF" BorderBrush="#CADCFF" BorderThickness="1">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Được giao" Binding="{Binding AssignedCount}" Width="0.7*" />
                                <DataGridTextColumn Header="Đang xử lý" Binding="{Binding ProcessingCount}" Width="0.75*" />
                                <DataGridTextColumn Header="Hoàn thành" Binding="{Binding CompletedCount}" Width="0.75*" />
                                <DataGridTextColumn Header="Sắp hạn" Binding="{Binding DueSoonCount}" Width="0.65*" />
                                <DataGridTextColumn Header="Quá hạn" Binding="{Binding OverdueCount}" Width="0.65*" />
                                <DataGridTemplateColumn Header="Tỷ lệ đúng hạn" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OnTimeRateText}"
                                                       Foreground="{Binding OnTimeRateColor}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="KPI" Width="1.05*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KpiPercent, StringFormat={}{0}%}" FontSize="12" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1"
                                                             Height="7"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding KpiPercent}"
                                                             Foreground="#35C47B"
                                                             Background="#E9EEF6"
                                                             VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="1.0*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding KpiStatusBackground}"
                                                    CornerRadius="10"
                                                    Height="22"
                                                    Padding="10,0"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding KpiStatus}"
                                                           Style="{StaticResource TinyPillText}"
                                                           Foreground="{Binding KpiStatusForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="16,10,16,12">
                            <TextBlock Text="{Binding StaffRowsSummaryText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding PreviousStaffPageCommand}"
                                        ToolTip="Trang trước">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Border Background="#F8FAFD"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="36"
                                        MinWidth="92"
                                        Margin="8,0"
                                        Padding="14,0">
                                    <TextBlock Text="{Binding StaffPageText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding NextStaffPageCommand}"
                                        ToolTip="Trang sau">
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>

                <Grid Grid.Row="2"
                      Grid.ColumnSpan="3"
                      Height="330"
                      Margin="0,14,0,0"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#EAF2FF">
                                    <TextBlock Text="&#xE9D2;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0B5CFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="HIỆU SUẤT XỬ LÝ THEO CÁN BỘ" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="So sánh tỷ lệ đúng hạn và KPI của từng cán bộ"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,8">
                                <Ellipse Width="8" Height="8" Fill="#0B5CFF" VerticalAlignment="Center" />
                                <TextBlock Text="Đúng hạn" FontSize="12" Margin="6,0,16,0" />
                                <Ellipse Width="8" Height="8" Fill="#35C47B" VerticalAlignment="Center" />
                                <TextBlock Text="KPI" FontSize="12" Margin="6,0,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2"
                                    Background="#FBFCFF"
                                    BorderBrush="#ECF1F8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6,8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="#E3EAF4" BorderThickness="0,0,0,1" />
                                <ItemsControl Grid.Row="0" ItemsSource="{Binding BarStats}" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                <Grid Height="122" Width="44">
                                                    <Border Width="16"
                                                            Height="{Binding OnTimeHeight}"
                                                            Background="#0B5CFF"
                                                            CornerRadius="4,4,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom" />
                                                    <Border Width="16"
                                                            Height="{Binding KpiHeight}"
                                                            Background="#35C47B"
                                                            CornerRadius="4,4,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding BarStats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StaffName}"
                                                       FontSize="11"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StaffName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFF0E8">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#FF6B2C"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TÌNH TRẠNG DEADLINE" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Phân bố hồ sơ theo thời hạn xử lý"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1"
                                    Background="#FBFCFF"
                                    BorderBrush="#ECF1F8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,10,0,8"
                                    Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="142" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="124" Height="124" Stretch="Uniform">
                                    <Grid Width="190" Height="190">
                                        <Ellipse Stroke="#ECF1F8" StrokeThickness="26" Fill="#F8FAFD" />
                                        <ItemsControl ItemsSource="{Binding DeadlineStats}"
                                                      Width="190"
                                                      Height="190">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path Data="{Binding Converter={StaticResource StatusDonutSegmentConverter}}"
                                                          Stroke="{Binding Color}"
                                                          StrokeThickness="26"
                                                          StrokeStartLineCap="Flat"
                                                          StrokeEndLineCap="Flat" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Ellipse Width="104" Height="104" Fill="White" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalDeadlineRecordsText}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Hồ sơ" FontSize="12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding DeadlineStats}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Count, StringFormat={}{0:N0}}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Text="Dữ liệu cập nhật đến 03/09/2026 09:30"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="3">
                        <Border Style="{StaticResource CardBorder}"
                                Padding="14"
                                Visibility="{Binding CanSendLeadershipNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#EAF2FF">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="THAO TÁC CÁN BỘ" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="Gửi thông báo hoặc thiết lập chỉ tiêu KPI"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TabControl Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource LineBrush}"
                                            SelectedIndex="{Binding LeadershipActionTabIndex, Mode=OneTime}">
                                    <TabItem Header="Thông báo"
                                             Visibility="{Binding CanReadAdminNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,7">
                                                <TextBlock Text="Thông báo đã nhận"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding MarkNotificationsReadCommand}"
                                                        Height="26"
                                                        MinWidth="62"
                                                        Padding="8,0"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="Đã đọc" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>

                                            <ScrollViewer Grid.Row="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Notifications}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource MetricCardButton}"
                                                                    Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,0,6"
                                                                    ToolTip="Bấm để xem toàn bộ thông báo">
                                                                <Border Background="{Binding BackgroundColor}"
                                                                        BorderBrush="{Binding BorderColor}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="16" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Fill="#E3342F"
                                                                                 VerticalAlignment="Top"
                                                                                 Margin="0,5,0,0"
                                                                                 Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Message}"
                                                                                       MaxHeight="38"
                                                                                       TextWrapping="Wrap"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       FontWeight="{Binding FontWeightText}"
                                                                                       Foreground="{StaticResource TextBrush}"
                                                                                       LineHeight="19" />
                                                                            <TextBlock Text="{Binding ReceivedText}"
                                                                                       FontSize="10"
                                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="&#xE76C;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NotificationPageText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding PreviousNotificationPageCommand}"
                                                        ToolTip="Trang trước"
                                                        Margin="0,0,5,0">
                                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding NextNotificationPageCommand}"
                                                        ToolTip="Trang sau">
                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Nhắc nhở">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Phạm vi thông báo"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox Grid.Row="1"
                                                      ItemsSource="{Binding LeadershipScopes}"
                                                      SelectedItem="{Binding SelectedLeadershipScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="32"
                                                      Margin="0,0,0,8" />
                                            <TextBlock Grid.Row="2"
                                                       Text="Nội dung thông báo"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Grid.Row="3"
                                                     MinHeight="54"
                                                     Text="{Binding LeadershipNoticeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     Margin="0,0,0,8" />
                                            <Button Grid.Row="4"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding SaveLeadershipDirectiveCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="34"
                                                    Padding="8,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                                                    <TextBlock Text="Gửi thông báo" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Grid.Row="5"
                                                       Text="{Binding LeadershipActionStatus}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="28"
                                                       Margin="0,6,0,0" />
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Đặt KPI"
                                             Visibility="{Binding CanSetLeadershipKpi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Phạm vi áp dụng"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox Grid.Row="1"
                                                      ItemsSource="{Binding LeadershipScopes}"
                                                      SelectedItem="{Binding SelectedLeadershipScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="32"
                                                      Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="2"
                                                       Text="Chỉ tiêu hồ sơ"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Grid.Row="3"
                                                     Text="{Binding LeadershipKpiTargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="32"
                                                     VerticalContentAlignment="Center"
                                                     Margin="0,0,0,10" />
                                            <Button Grid.Row="4"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding SaveLeadershipKpiCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="34"
                                                    Padding="8,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                                                    <TextBlock Text="Lưu KPI" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Grid.Row="5"
                                                       Text="{Binding LeadershipKpiStatus}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="28"
                                                       Margin="0,6,0,0" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}"
                                Padding="14"
                                Visibility="{Binding ShowStandaloneNotificationInbox, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#EAF2FF">
                                        <TextBlock Text="&#xE8BD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="THÔNG BÁO" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="Tin nhắn từ lãnh đạo" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding MarkNotificationsReadCommand}"
                                            Height="28"
                                            MinWidth="62"
                                            Padding="8,0">
                                        <TextBlock Text="Đã đọc" FontSize="11" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MetricCardButton}"
                                                        Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,0,7"
                                                        ToolTip="Bấm để xem toàn bộ thông báo">
                                                    <Border Background="{Binding BackgroundColor}"
                                                            BorderBrush="{Binding BorderColor}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="7"
                                                                     Height="7"
                                                                     Fill="#E3342F"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,5,0,0"
                                                                     Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Message}"
                                                                           MaxHeight="38"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontWeight="{Binding FontWeightText}"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           LineHeight="19" />
                                                                <TextBlock Text="{Binding ReceivedText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,5,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="&#xE76C;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NotificationPageText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding PreviousNotificationPageCommand}"
                                            ToolTip="Trang trước"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Command="{Binding NextNotificationPageCommand}"
                                            ToolTip="Trang sau">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            <Grid Grid.Row="1" Grid.Column="2" VerticalAlignment="Stretch">
                <Border x:Name="RightInfoCard"
                        Style="{StaticResource CardBorder}"
                        Padding="14"
                        VerticalAlignment="Stretch">
                    <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Thông tin cán bộ" Style="{StaticResource SectionTitleText}" />
                    </Grid>

                    <Border Width="74" Height="74" CornerRadius="37" Background="#EAF2FF" HorizontalAlignment="Center" Margin="0,2,0,10">
                        <TextBlock Text="{Binding SelectedStaff.Initials}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding SelectedStaff.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedStaff.Position}"
                               Style="{StaticResource MutedText}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,18" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hồ sơ được giao" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedStaff.AssignedCount}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Đang xử lý" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStaff.ProcessingCount}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="Đã hoàn thành" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStaff.CompletedCount}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="Tỷ lệ đúng hạn" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedStaff.OnTimeRateText}" Foreground="#0FA958" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Text="Thời gian xử lý TB" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedStaff.AverageProcessingTimeText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="KPI tháng 09/2026" FontWeight="Bold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Chỉ tiêu đặt ra" />
                                <TextBlock Text="{Binding LeadershipKpiTargetText, StringFormat={}{0} hồ sơ}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Đã hoàn thành" />
                                <TextBlock Text="{Binding SelectedStaffCompletionText}" Foreground="#0FA958" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tiến độ" />
                                <TextBlock Text="{Binding SelectedStaffTargetProgressText}" Foreground="#0FA958" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding SelectedStaffTargetProgressPercent, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" Background="#E9EEF6" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Border>


            </Grid>
        </Grid>
    </ScrollViewer>

        <Border Background="#660B1633"
                Panel.ZIndex="100"
                Visibility="{Binding IsNotificationDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520"
                    MaxHeight="520"
                    Background="White"
                    BorderBrush="#CBD8EA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="8"
                                      Opacity="0.22"
                                      Color="#06164A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#EAF2FF">
                            <TextBlock Text="&#xE8BD;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="CHI TIẾT THÔNG BÁO" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding SelectedNotification.ReceivedText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding CloseNotificationCommand}"
                                ToolTip="Đóng">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#F8FAFD"
                            BorderBrush="#DDE7F5"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="350">
                            <TextBlock Text="{Binding SelectedNotification.Message}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14"
                                       LineHeight="22" />
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloseNotificationCommand}"
                            HorizontalAlignment="Right"
                            MinWidth="92"
                            Margin="0,16,0,0"
                            Content="Đóng" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
