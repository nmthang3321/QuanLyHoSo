<UserControl x:Class="QuanLyHoSo.Views.Records.RecordInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="NHẬP DỮ LIỆU" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Tiếp nhận và nhập thông tin hồ sơ" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Thêm mới" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Danh sách hồ sơ" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="1. THÔNG TIN CHUNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock><Run Text="Số hồ sơ / Số đơn" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding RecordCode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock><Run Text="Ngày tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding ReceivedDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock><Run Text="Nguồn tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <ComboBox ItemsSource="{Binding ReceiveSources}" SelectedItem="{Binding ReceiveSource}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock><Run Text="Người tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding ReceiverName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock><Run Text="Người gửi đơn / Người tố giác" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding SenderName}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Text="Số điện thoại" />
                            <TextBox Text="{Binding SenderPhone}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Địa chỉ liên hệ" />
                            <TextBox Text="{Binding ContactAddress}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock><Run Text="Địa bàn (xã/phường/đặc khu)" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding AreaName}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Địa chỉ xảy ra vụ việc" />
                            <TextBox Text="{Binding IncidentAddress}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4">
                            <TextBlock><Run Text="Nội dung đơn / Nội dung vụ việc" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Height="76"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="{Binding Content}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="2. THÔNG TIN LIÊN QUAN" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock><Run Text="Loại vụ việc" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding CaseTypes}" SelectedItem="{Binding CaseType}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock><Run Text="Nhóm nội dung" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding ContentGroups}" SelectedItem="{Binding ContentGroup}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock><Run Text="Lĩnh vực" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Đối tượng liên quan" />
                                <TextBox Text="{Binding RelatedPerson}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Ghi chú" />
                        <TextBox Height="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Note}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="3. THÔNG TIN BỔ SUNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Hình thức xử lý mong muốn" />
                                <ComboBox ItemsSource="{Binding HandlingMethods}" SelectedItem="{Binding ExpectedHandlingMethod}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Mức độ vụ việc" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SeverityLevel}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Ngày hẹn trả kết quả" />
                                <TextBox Text="{Binding ExpectedResultDate}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ưu tiên" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding PriorityLevel}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Ghi chú bổ sung" />
                        <TextBox Height="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding AdditionalNote}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource DangerButton}" MinWidth="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Xóa" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Lưu" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Content="Hủy bỏ" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TÀI LIỆU LIÊN QUAN (ĐÍNH KÈM)" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileSize}" Style="{StaticResource MutedText}" />
                                        <TextBlock Grid.Column="2" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#E11414" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#7FAEFF" BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Kéo thả file vào đây hoặc" HorizontalAlignment="Center" Margin="0,8,0,10" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Chọn file" MinWidth="110" />
                            <TextBlock Text="PDF, JPG, PNG - tối đa 10MB/file" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

