<UserControl x:Class="QuanLyHoSo.Views.Records.RecordInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InputLabelText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ReceivedCalendarDayButton" TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReceivedCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#7FAEFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ReceivedCalendarDayButton}" />
        </Style>

        <Style x:Key="ReceivedDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#7FAEFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="FirstDayOfWeek" Value="Monday" />
            <Setter Property="CalendarStyle" Value="{StaticResource ReceivedCalendarStyle}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="NHẬP DỮ LIỆU" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Tiếp nhận và nhập thông tin hồ sơ" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Thêm mới" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowRecordListCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Danh sách hồ sơ" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="1. THÔNG TIN CHUNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Số hồ sơ / Số đơn" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding RecordCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Ngày tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <DatePicker Style="{StaticResource ReceivedDatePickerStyle}"
                                        SelectedDate="{Binding SelectedReceivedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Language="vi-VN" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Nguồn tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <ComboBox ItemsSource="{Binding ReceiveSources}" SelectedItem="{Binding ReceiveSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Người tiếp nhận" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding ReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Người gửi đơn / Người tố giác" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Text="{Binding SenderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource InputLabelText}" />
                            <TextBox Text="{Binding SenderPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Địa chỉ liên hệ" Style="{StaticResource InputLabelText}" />
                            <TextBox Text="{Binding ContactAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Địa bàn (xã/phường/đặc khu)" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <ComboBox x:Name="AreaComboBox"
                                      ItemsSource="{Binding FilteredAreas}"
                                      SelectedItem="{Binding AreaName, Mode=TwoWay}"
                                      Text="{Binding AreaSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      KeyUp="AreaComboBox_KeyUp" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Địa chỉ xảy ra vụ việc" Style="{StaticResource InputLabelText}" />
                            <TextBox Text="{Binding IncidentAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="4">
                            <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Nội dung đơn / Nội dung vụ việc" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Height="76"
                                     VerticalContentAlignment="Top"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="2. THÔNG TIN LIÊN QUAN" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Loại vụ việc" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding CaseTypes}" SelectedItem="{Binding CaseType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Nhóm nội dung" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding ContentGroups}" SelectedItem="{Binding ContentGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource InputLabelText}"><Run Text="Lĩnh vực" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding Field, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Đối tượng liên quan" Style="{StaticResource InputLabelText}" />
                                <TextBox Text="{Binding RelatedPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Ghi chú" Style="{StaticResource InputLabelText}" />
                        <TextBox Height="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="3. THÔNG TIN BỔ SUNG" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Hình thức xử lý mong muốn" Style="{StaticResource InputLabelText}" />
                                <ComboBox ItemsSource="{Binding HandlingMethods}" SelectedItem="{Binding ExpectedHandlingMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Mức độ vụ việc" Style="{StaticResource InputLabelText}" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SeverityLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Ngày hẹn trả kết quả" Style="{StaticResource InputLabelText}" />
                                <TextBox Text="{Binding ExpectedResultDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ưu tiên" Style="{StaticResource InputLabelText}" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding PriorityLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Ghi chú bổ sung" Style="{StaticResource InputLabelText}" />
                        <TextBox Height="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding AdditionalNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TÀI LIỆU LIÊN QUAN (ĐÍNH KÈM)" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                        <Border Margin="0,12,18,0"
                                MinHeight="148"
                                Background="#F7FAFF"
                                BorderBrush="#D8E7FF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Chưa có tài liệu đính kèm"
                                       Style="{StaticResource MutedText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,10,18,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7FAFF"
                                            BorderBrush="#D8E7FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileSize}" Style="{StaticResource MutedText}" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="28"
                                                MinWidth="28"
                                                Height="28"
                                                Padding="0"
                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xem tài liệu">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" />
                                        </Button>
                                        <Button Grid.Column="3"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="28"
                                                MinWidth="28"
                                                Height="28"
                                                Padding="0"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xóa tài liệu">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#E11414" />
                                        </Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border x:Name="AttachmentDropZone"
                            Grid.Column="1"
                            Background="White"
                            BorderBrush="#7FAEFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            MinHeight="148"
                            AllowDrop="True"
                            PreviewDragEnter="AttachmentDropZone_PreviewDragEnter"
                            PreviewDragOver="AttachmentDropZone_PreviewDragOver"
                            PreviewDragLeave="AttachmentDropZone_PreviewDragLeave"
                            PreviewDrop="AttachmentDropZone_PreviewDrop"
                            DragEnter="AttachmentDropZone_DragEnter"
                            DragOver="AttachmentDropZone_DragOver"
                            DragLeave="AttachmentDropZone_DragLeave"
                            Drop="AttachmentDropZone_Drop">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AllowDrop="True"
                                    PreviewDragEnter="AttachmentDropZone_PreviewDragEnter"
                                    PreviewDragOver="AttachmentDropZone_PreviewDragOver"
                                    PreviewDrop="AttachmentDropZone_PreviewDrop">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Kéo thả file vào đây hoặc" HorizontalAlignment="Center" Margin="0,8,0,10" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Chọn file"
                                    MinWidth="110"
                                    Click="ChooseAttachmentFilesButton_Click" />
                            <TextBlock Text="PDF, JPG, PNG - tối đa 10MB/file" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource DangerButton}"
                            MinWidth="100"
                            Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Xóa" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Lưu" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Hủy bỏ"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

