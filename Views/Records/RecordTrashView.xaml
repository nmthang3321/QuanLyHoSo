<UserControl x:Class="QuanLyHoSo.Views.Records.RecordTrashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F5F7FB" IsVisibleChanged="TrashView_IsVisibleChanged"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="24" Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="THÙNG RÁC HỒ SƠ" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Hồ sơ đã xóa được lưu tại đây để khôi phục khi cần." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
            <DockPanel>
                <Grid DockPanel.Dock="Right" Width="280" Margin="16,0,0,0">
                    <TextBox x:Name="TrashSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tìm theo mã hồ sơ, người gửi hoặc người xóa" />
                    <TextBlock Text="Tìm mã hồ sơ, người gửi, người xóa…" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TrashSearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <CheckBox Content="Chọn tất cả kết quả" IsChecked="{Binding SelectAll, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <TextBlock Text="{Binding SelectionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredRows}" AutoGenerateColumns="False" IsReadOnly="True"
                  IsEnabled="{Binding IsIdle}" CanUserAddRows="False" RowHeight="38" HeadersVisibility="Column"
                  EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Chọn" Width="55">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Record.RecordCode}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Mã hồ sơ" Binding="{Binding Record.RecordCode}" Width="140" />
                <DataGridTextColumn Header="Người gửi" Binding="{Binding Record.SenderName}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Trạng thái trước khi xóa" Binding="{Binding Record.Status}" Width="165" />
                <DataGridTextColumn Header="Người xử lý" Binding="{Binding Record.ProcessorName}" Width="140" />
                <DataGridTextColumn Header="Người xóa" Binding="{Binding Record.DeletedBy}" Width="130" />
                <DataGridTextColumn Header="Thời điểm xóa" Binding="{Binding Record.DeletedAt}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsIdle}">
                <Button Command="{Binding DeletePermanentlyCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        ToolTip="Xóa vĩnh viễn các hồ sơ đã chọn trong thùng rác">
                    <TextBlock Text="Xóa vĩnh viễn" Foreground="#E11414" />
                </Button>
                <Button Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                    <TextBlock Text="Khôi phục đã chọn" Foreground="White" />
                </Button>
                <Button Content="Đóng" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
