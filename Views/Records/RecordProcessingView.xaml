<UserControl x:Class="QuanLyHoSo.Views.Records.RecordProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="QueueIconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F0F6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E4EEFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="ProcessingQueueScrollViewer"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProcessingDetailOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="PHÂN LOẠI HỒ SƠ" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="Hàng chờ hồ sơ cần phân loại, phân công và theo dõi xử lý" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Metrics}" Margin="-6,0,-6,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MetricCardButton}"
                                    Command="{Binding DataContext.SelectMetricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="6,0,6,12">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Background" Value="#F8FAFD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="23" Background="{Binding AccentColor}">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="White"
                                                       FontSize="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                            <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Margin="0,6,0,4" />
                                            <TextBlock Text="{Binding Delta}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HỒ SƠ CẦN XỬ LÝ" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding TotalRecordsText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding QueueRecords}"
                                  Height="{Binding TableHeight}"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ProcessingQueueDataGrid_PreviewMouseWheel"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="52" MinWidth="48" />
                                <DataGridTextColumn Header="Số hồ sơ" Binding="{Binding RecordCode}" Width="0.8*" MinWidth="110" />
                                <DataGridTextColumn Header="Ngày tiếp nhận" Binding="{Binding ReceivedDate}" Width="0.8*" MinWidth="120" />
                                <DataGridTextColumn Header="Người gửi" Binding="{Binding SenderName}" Width="1.25*" MinWidth="160" />
                                <DataGridTextColumn Header="Địa bàn" Binding="{Binding AreaName}" Width="1.05*" MinWidth="140" />
                                <DataGridTextColumn Header="Loại vụ việc" Binding="{Binding CaseType}" Width="0.95*" MinWidth="120" />
                                <DataGridTemplateColumn Header="Mức độ" Width="0.8*" MinWidth="105" ClipboardContentBinding="{Binding SeverityLevel}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF7E8" BorderBrush="#FFE0A8" BorderThickness="1" CornerRadius="4" Height="22" Padding="7,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding SeverityLevel}" FontSize="12" FontWeight="SemiBold" Foreground="#8A5200" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="1.0*" MinWidth="140" ClipboardContentBinding="{Binding Status}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="4" Height="22" Padding="7,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="88" MinWidth="88" MaxWidth="88" CellStyle="{StaticResource ActionCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource QueueIconButton}"
                                                        Command="{Binding DataContext.ViewRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xem">
                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" />
                                                </Button>
                                                <Button Style="{StaticResource QueueIconButton}"
                                                        Command="{Binding DataContext.OpenProcessingDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0"
                                                        ToolTip="Phân loại / xử lý">
                                                    <TextBlock Text="&#xE72C;"
                                                               FontFamily="pack://application:,,,/Assets/Fonts/#Material Symbols Outlined"
                                                               Foreground="#159A72" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Text="{Binding PageSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="58"
                                         Height="36"
                                         HorizontalContentAlignment="Center" />
                                <TextBlock Text="Tối đa 50"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding PreviousPageCommand}"
                                        ToolTip="Trang trước">
                                    <TextBlock Text="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Border Background="#F8FAFD"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="36"
                                        MinWidth="92"
                                        Margin="8,0"
                                        Padding="14,0">
                                    <TextBlock Text="{Binding PageText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Width="36"
                                        MinWidth="36"
                                        Height="36"
                                        Padding="0"
                                        Command="{Binding NextPageCommand}"
                                        ToolTip="Trang sau">
                                    <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProcessingDetailOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="CHI TIẾT XỬ LÝ HỒ SƠ" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{Binding SelectedProcessingDetail.RecordCode, StringFormat=Hồ sơ: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding BackToQueueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Quay lại" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="176" />
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="25" Background="#EAF2FF">
                            <TextBlock Text="&#xF368;"
                                       FontFamily="pack://application:,,,/Assets/Fonts/#Material Symbols Outlined"
                                       FontSize="24"
                                       FontWeight="ExtraLight"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedProcessingDetail.RecordCode}" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" />
                                <Border Background="{Binding SelectedProcessingDetail.Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="4" Height="22" Padding="7,1">
                                    <TextBlock Text="{Binding SelectedProcessingDetail.Status}" Foreground="{Binding SelectedProcessingDetail.Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedProcessingDetail.ReceivedDate, StringFormat=Ngày tiếp nhận: {0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.ReceiveSource, StringFormat=Nguồn tiếp nhận: {0}}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Người gửi đơn" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.SenderName}" Style="{StaticResource DetailValueText}" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.SenderPhone}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Địa bàn" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.AreaName}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Loại vụ việc" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.CaseType}" Style="{StaticResource DetailValueText}" />
                            <TextBlock Text="{Binding SelectedProcessingDetail.Field}" />
                        </StackPanel>
                        <Button Grid.Column="5"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ViewProcessingDetailCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Xem chi tiết hồ sơ" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="QUY TRÌNH XỬ LÝ HỒ SƠ" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding ProcessSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Grid Height="58">
                                            <Border Height="2"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,29,0"
                                                    Visibility="{Binding HasPreviousStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D8E2F3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPreviousConnectorDone}" Value="True">
                                                                <Setter Property="Background" Value="#24A148" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border Height="2"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Margin="29,0,0,0"
                                                    Visibility="{Binding HasNextStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D8E2F3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNextConnectorDone}" Value="True">
                                                                <Setter Property="Background" Value="#24A148" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <Border CornerRadius="29" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="58" />
                                                        <Setter Property="Height" Value="58" />
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Setter Property="Background" Value="#EEF2F8" />
                                                        <Setter Property="BorderBrush" Value="#D8E2F3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Background" Value="#24A148" />
                                                                <Setter Property="BorderBrush" Value="#24A148" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="#0B5CFF" />
                                                                <Setter Property="BorderBrush" Value="#0B5CFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#151B2B" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value="Kết quả xử lý ban đầu">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="&#xEF3E;"
                                                       FontFamily="pack://application:,,,/Assets/Fonts/#Material Symbols Outlined"
                                                       FontSize="22"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Foreground" Value="#151B2B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value="Kết quả xử lý ban đầu">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,2">
                                            <TextBlock Text="{Binding StepNumber, StringFormat={}{0}. }" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="#24A148" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Foreground" Value="#24A148" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#24A148" Margin="6,1,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="LỊCH SỬ XỬ LÝ" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0" Padding="0" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Border Width="2" HorizontalAlignment="Center" Margin="0,17,0,-14"
                                                            Visibility="{Binding HasNextItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E1E8F2" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNextConnectorDone}" Value="True">
                                                                        <Setter Property="Background" Value="#24A148" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Grid Width="13" Height="13" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                        <Ellipse StrokeThickness="1.5">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="White" />
                                                                    <Setter Property="Stroke" Value="#8A96B2" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Fill" Value="#24A148" />
                                                                            <Setter Property="Stroke" Value="#24A148" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Fill" Value="#0B5CFF" />
                                                                            <Setter Property="Stroke" Value="#0B5CFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#8A96B2" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0D8A2A" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="#0B5CFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ProcessedAt}"
                                                                   Style="{StaticResource MutedText}"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProcessorName, StringFormat=Người xử lý: {0}}"
                                                               Margin="0,4,0,2"
                                                               Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding Content}"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource MutedText}"
                                                               Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0" IsEnabled="{Binding CanUpdateProcessing}">
                        <StackPanel>
                            <TextBlock Text="CẬP NHẬT XỬ LÝ" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Style="{StaticResource FieldLabelText}"><Run Text="Trạng thái hiện tại" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                    <ComboBox ItemsSource="{Binding ProcessingStatuses}" SelectedItem="{Binding ProcessingStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabelText}"><Run Text="Ngày xử lý" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                                    <DatePicker SelectedDate="{Binding SelectedProcessingDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Language="vi-VN" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Cơ quan chuyển đến" Style="{StaticResource FieldLabelText}" />
                                <ComboBox ItemsSource="{Binding TransferAreaChoices}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="FilterValue"
                                          SelectedValue="{Binding TransferAreaName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProcessingStatus}" Value="Chuyển cơ quan khác">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelText}"><Run Text="Người xử lý" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <ComboBox ItemsSource="{Binding ProcessorNames}"
                                      Text="{Binding ProcessingProcessorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource FieldLabelText}"><Run Text="Nội dung xử lý" /><Run Text=" *" Foreground="#E11414" /></TextBlock>
                            <TextBox Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ProcessingContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                            <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabelText}" />
                            <TextBox Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding ProcessingNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />
                            <TextBlock Text="Tài liệu liên quan" Style="{StaticResource FieldLabelText}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#D8E7FF" BorderThickness="1" Background="#F7FAFF" Padding="8" Margin="0,0,6,0" MinHeight="82">
                                    <Grid>
                                        <TextBlock Text="Chưa có tài liệu đính kèm"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Visibility="{Binding HasAttachments, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FileSize}" Style="{StaticResource MutedText}" FontSize="11" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="28" MinWidth="28" Height="28" Padding="0" Margin="4,0,3,0" Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Mở tài liệu">
                                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" />
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Width="28" MinWidth="28" Height="28" Padding="0" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Xóa tài liệu">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#E11414" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" AllowDrop="True" Drop="ProcessingAttachmentDropZone_Drop" BorderBrush="#7FAEFF" BorderThickness="1" Background="White" Padding="8" MinHeight="82">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" AllowDrop="True" Drop="ProcessingAttachmentDropZone_Drop">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Kéo thả file vào đây" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="PDF, JPG, PNG - tối đa 10MB/file" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Chọn file" Click="ChooseProcessingAttachmentFilesButton_Click" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Button Style="{StaticResource DangerButton}" Content="Hủy xử lý" HorizontalAlignment="Left" Command="{Binding BackToQueueCommand}" />
                                <Button HorizontalAlignment="Right" Command="{Binding SaveProcessingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ButtonBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0051E8" />
                                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0051E8" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0045C7" />
                                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0045C7" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Cập nhật" Foreground="White" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#9906164A"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="980"
                    MaxHeight="640"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.22" Color="#06164A" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT HỒ SƠ" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedRecordDetail.RecordCode}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Width="36" MinWidth="36" Height="36" Padding="0" HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}" ToolTip="Đóng">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Ngày tiếp nhận" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.ReceivedDate}" Style="{StaticResource DetailValueText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,12">
                                    <TextBlock Text="Nguồn tiếp nhận" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.ReceiveSource}" Style="{StaticResource DetailValueText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Người tiếp nhận" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.ReceiverName}" Style="{StaticResource DetailValueText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,12,12">
                                    <TextBlock Text="Người gửi / Người tố giác" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.SenderName}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.SenderPhone}" Style="{StaticResource DetailValueText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Địa bàn" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.AreaName}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,12,12">
                                    <TextBlock Text="Địa chỉ liên hệ" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.ContactAddress}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Địa chỉ xảy ra vụ việc" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.IncidentAddress}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,0,12,0">
                                    <TextBlock Text="Loại vụ việc" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.CaseType}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Nhóm nội dung" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.ContentGroup}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2">
                                    <TextBlock Text="Lĩnh vực" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.Field}" Style="{StaticResource DetailValueText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#F7FAFF" BorderBrush="#D8E7FF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Nội dung đơn / Nội dung vụ việc" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SelectedRecordDetail.Content}" TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Thông tin xử lý" Style="{StaticResource SubsectionTitleText}" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.ExpectedHandlingMethod, StringFormat=Đề xuất cán bộ: {0}}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.SenderExpectedHandlingMethod, StringFormat=Đề xuất người gửi: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.SeverityLevel, StringFormat=Mức độ: {0}}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.ExpectedResultDate, StringFormat=Ngày hẹn trả: {0}}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Ghi chú" Style="{StaticResource SubsectionTitleText}" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.Note}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedRecordDetail.AdditionalNote}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#F8FAFD"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Tài liệu đính kèm" Style="{StaticResource SubsectionTitleText}" />
                                    <ItemsControl ItemsSource="{Binding SelectedRecordDetail.Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" Margin="0,14,0,0" Command="{Binding CloseDetailCommand}">
                        <TextBlock Text="Đóng" Foreground="{StaticResource PrimaryBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
