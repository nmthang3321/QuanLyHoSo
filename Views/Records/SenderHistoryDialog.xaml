<UserControl x:Class="QuanLyHoSo.Views.Records.SenderHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        KeyboardNavigation.TabNavigation="Cycle" Loaded="OnLoaded">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Chọn hồ sơ để đối chiếu nội dung và lịch sử xử lý trước khi xác nhận là hồ sơ gửi lại."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  GridLinesVisibility="All" VerticalGridLinesBrush="#ECF1F8"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  ItemsSource="{Binding SenderRecords}" SelectedItem="{Binding SelectedSenderRecord, Mode=TwoWay}">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF2FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF2FF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EAF2FF" />
                            <Setter Property="BorderBrush" Value="#7EA8FF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EAF2FF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã hồ sơ" Binding="{Binding RecordCode}" Width="140"/>
                <DataGridTextColumn Header="Ngày nhận" Binding="{Binding ReceivedDate}" Width="100"/>
                <DataGridTextColumn Header="Loại vụ việc" Binding="{Binding CaseType}" Width="120"/>
                <DataGridTextColumn Header="Địa bàn" Binding="{Binding AreaName}" Width="180"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplay}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Xác thực" Binding="{Binding SenderMatchDisplay}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12">
            <StackPanel DataContext="{Binding SelectedItem, ElementName=HistoryGrid}">
                <TextBlock Text="{Binding Relationship}" FontWeight="Bold"/>
                <TextBlock Text="Nội dung hồ sơ trước" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                <TextBlock Text="Lịch sử / kết quả xử lý" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Text="{Binding ResolutionSummary}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3">
            <TextBlock><Run Text="Lý do gửi lại"/><Run Text=" *" Foreground="#E11414"/></TextBlock>
            <TextBox x:Name="ReasonBox" Text="{Binding ResubmissionReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="52" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,12"/>
            <TextBlock Text="{Binding SenderHistoryError}" Foreground="#D42D16" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy lưu"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="128"
                    Margin="0,0,12,0"
                    Command="{Binding CloseSenderHistoryCommand}" />
            <Button x:Name="LinkButton"
                    MinWidth="138"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanSaveResubmission}"
                    Command="{Binding SaveResubmissionCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" Foreground="White" />
                    <TextBlock Text="Xác nhận hồ sơ gửi lại" Foreground="White" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
