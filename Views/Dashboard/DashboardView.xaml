<UserControl x:Class="QuanLyHoSo.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DateFilterMenuItem" TargetType="MenuItem">
            <EventSetter Event="Click" Handler="DateFilterMenuItem_Click" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,18" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="TỔNG QUAN" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Tình hình tiếp nhận và xử lý hồ sơ" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Right">
                    <Button x:Name="DateFilterHost"
                            Style="{StaticResource SecondaryButton}"
                            Width="312"
                            Height="38"
                            Click="DateFilterButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.DateFilterOptions, RelativeSource={RelativeSource Self}}"
                                         MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                         Placement="Bottom"
                                         ItemContainerStyle="{StaticResource DateFilterMenuItem}" />
                        </Button.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DateRangeText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Popup x:Name="CustomDateRangePopup"
                           IsOpen="{Binding IsCustomCalendarOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=DateFilterHost}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Opened="CustomDateRangePopup_Opened">
                        <Border Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,6,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="4"
                                                  Opacity="0.16"
                                                  Color="#06164A" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Button Content="Áp dụng"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            MinWidth="86"
                                            Click="ApplyCustomDateRangeButton_Click" />
                                </Grid>
                                <Calendar x:Name="CustomDateRangeCalendar"
                                          SelectionMode="SingleRange"
                                          PreviewMouseLeftButtonDown="CustomDateRangeCalendar_PreviewMouseLeftButtonDown" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <ItemsControl ItemsSource="{Binding Metrics}" Margin="-6,0,-6,14" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{Binding AccentColor}">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="White"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Margin="0,8,0,8" />
                                    <TextBlock Text="{Binding Delta}" Style="{StaticResource MutedText}" Foreground="#0D8A2A" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,14" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="HỒ SƠ THEO TRẠNG THÁI" Style="{StaticResource SectionTitleText}" />
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="190" Height="190">
                                <Ellipse Fill="#F8FAFD" Stroke="#ECF1F8" StrokeThickness="26" />
                                <ItemsControl ItemsSource="{Binding StatusStats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Converter={StaticResource StatusDonutSegmentConverter}}"
                                                  Stroke="{Binding Color}"
                                                  StrokeThickness="26"
                                                  StrokeStartLineCap="Flat"
                                                  StrokeEndLineCap="Flat" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Ellipse Width="104" Height="104" Fill="White" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding TotalRecordsText}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="hồ sơ" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                            <Grid Grid.Column="2" Height="10" VerticalAlignment="Center">
                                                <Border Background="#ECF1F8" CornerRadius="4" />
                                                <Border Width="{Binding Width}" Background="{Binding Color}" CornerRadius="4" HorizontalAlignment="Left" />
                                            </Grid>
                                            <TextBlock Grid.Column="3" Text="{Binding Count}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Percentage}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="HỒ SƠ THEO ĐỊA BÀN - TOP 5" Style="{StaticResource SectionTitleText}" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding AreaStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AreaName}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" Height="18" VerticalAlignment="Center">
                                            <Border Background="#ECF1F8" CornerRadius="4" />
                                            <Border Width="{Binding Width}" Background="{StaticResource PrimaryBrush}" CornerRadius="4" HorizontalAlignment="Left" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="HỒ SƠ CẬP NHẬT GẦN ĐÂY" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding RecentRecords}"
                              Height="{Binding RecentTableHeight}"
                              CanUserResizeColumns="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT"
                                                Binding="{Binding Index}"
                                                Width="58"
                                                MinWidth="48"
                                                MaxWidth="72" />
                            <DataGridTextColumn Header="Số hồ sơ"
                                                Binding="{Binding RecordCode}"
                                                Width="0.75*"
                                                MinWidth="105"
                                                MaxWidth="155" />
                            <DataGridTextColumn Header="Người gửi / Tổ chức"
                                                Binding="{Binding SenderName}"
                                                Width="1.6*"
                                                MinWidth="180"
                                                MaxWidth="420" />
                            <DataGridTextColumn Header="Địa bàn"
                                                Binding="{Binding AreaName}"
                                                Width="1.1*"
                                                MinWidth="130"
                                                MaxWidth="280" />
                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="1.05*"
                                                    MinWidth="145"
                                                    MaxWidth="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                CornerRadius="4"
                                                Height="22"
                                                Padding="7,1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Cập nhật cuối"
                                                Binding="{Binding UpdatedAt}"
                                                Width="1.05*"
                                                MinWidth="135"
                                                MaxWidth="220" />
                            <DataGridTextColumn Header="Người xử lý"
                                                Binding="{Binding ProcessorName}"
                                                Width="*"
                                                MinWidth="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Số dòng"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding RecentRecordsPageSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="58"
                                     Height="36"
                                     HorizontalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="36"
                                    MinWidth="36"
                                    Height="36"
                                    Padding="0"
                                    Command="{Binding PreviousRecentPageCommand}"
                                    ToolTip="Trang trước">
                                <TextBlock Text="&#xE76B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Border Background="#F8FAFD"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="36"
                                    MinWidth="92"
                                    Margin="8,0"
                                    Padding="14,0">
                                <TextBlock Text="{Binding RecentPageText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="36"
                                    MinWidth="36"
                                    Height="36"
                                    Padding="0"
                                    Command="{Binding NextRecentPageCommand}"
                                    ToolTip="Trang sau">
                                <TextBlock Text="&#xE76C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
