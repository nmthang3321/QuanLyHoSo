<UserControl x:Class="QuanLyHoSo.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DateFilterMenuItem" TargetType="MenuItem">
            <EventSetter Event="Click" Handler="DateFilterMenuItem_Click" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,18" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="TỔNG QUAN" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Tình hình tiếp nhận và xử lý hồ sơ" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Right">
                    <Button x:Name="DateFilterHost"
                            Style="{StaticResource SecondaryButton}"
                            Width="312"
                            Height="38"
                            Click="DateFilterButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.DateFilterOptions, RelativeSource={RelativeSource Self}}"
                                         MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                                         Placement="Bottom"
                                         ItemContainerStyle="{StaticResource DateFilterMenuItem}" />
                        </Button.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DateRangeText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Popup x:Name="CustomDateRangePopup"
                           IsOpen="{Binding IsCustomCalendarOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=DateFilterHost}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Opened="CustomDateRangePopup_Opened">
                        <Border Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,6,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="4"
                                                  Opacity="0.16"
                                                  Color="#06164A" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Button Content="Áp dụng"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            MinWidth="86"
                                            Click="ApplyCustomDateRangeButton_Click" />
                                </Grid>
                                <Calendar x:Name="CustomDateRangeCalendar"
                                          SelectionMode="SingleRange"
                                          PreviewMouseLeftButtonDown="CustomDateRangeCalendar_PreviewMouseLeftButtonDown" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <ItemsControl ItemsSource="{Binding Metrics}" Margin="-6,0,-6,14" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{Binding AccentColor}">
                                    <TextBlock Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="White"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding AccentColor}" />
                                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Margin="0,8,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DeltaGlyph}"
                                                   Foreground="{Binding DeltaColor}"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="15"
                                                   FontWeight="ExtraBold"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DeltaAmount}"
                                                   Foreground="{Binding DeltaColor}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DeltaDescription}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid x:Name="OverviewChartsGrid"
                  Margin="0,0,0,14"
                  HorizontalAlignment="Stretch"
                  SizeChanged="OverviewChartsGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="StatusChartCard"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="HỒ SƠ THEO TRẠNG THÁI" Style="{StaticResource SectionTitleText}" />
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="190" Height="190">
                                <Ellipse Fill="#F8FAFD" Stroke="#ECF1F8" StrokeThickness="26" />
                                <ItemsControl ItemsSource="{Binding StatusStats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Converter={StaticResource StatusDonutSegmentConverter}}"
                                                  Stroke="{Binding Color}"
                                                  StrokeThickness="26"
                                                  StrokeStartLineCap="Flat"
                                                  StrokeEndLineCap="Flat"
                                                  RenderTransformOrigin="0.5,0.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Ellipse Width="104" Height="104" Fill="White" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding TotalRecordsText}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="hồ sơ" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" MinWidth="72" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       Margin="0,0,8,0" />
                                            <Grid Grid.Column="2"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  ClipToBounds="True">
                                                <Border Background="#ECF1F8" CornerRadius="4" />
                                                <Border Width="{Binding Width}"
                                                        Background="{Binding Color}"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Loaded="HorizontalBar_Loaded"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Count}"
                                                       HorizontalAlignment="Right"
                                                       Margin="6,0,0,0" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Percentage}"
                                                       HorizontalAlignment="Right"
                                                       Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AreaChartCard"
                        Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="HỒ SƠ THEO ĐỊA BÀN - TOP 5" Style="{StaticResource SectionTitleText}" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding AreaStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AreaName}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1" Height="18" VerticalAlignment="Center">
                                            <Border Background="#ECF1F8" CornerRadius="4" />
                                            <Border Width="{Binding Width}"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Loaded="HorizontalBar_Loaded"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,14" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TrendChartCard"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        Margin="0"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="TÌNH HÌNH TIẾP NHẬN VÀ GIẢI QUYẾT HỒ SƠ"
                                   Style="{StaticResource SectionTitleText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,18" />
                        <Border Height="252" BorderBrush="#C8D0DE" BorderThickness="1,0,1,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <Canvas Grid.Column="0"
                                        Height="150"
                                        VerticalAlignment="Top"
                                        Margin="0,28,6,0"
                                        IsHitTestVisible="False">
                                    <ItemsControl ItemsSource="{Binding TrendAxisTicks}"
                                                  Width="32"
                                                  Height="150">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"
                                                           Width="32"
                                                           FontSize="12"
                                                           Foreground="#126BFF"
                                                           TextAlignment="Right" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                                <ScrollViewer Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="TrendChartScrollViewer_PreviewMouseWheel">
                                    <Grid Width="{Binding TrendChartWidth}" Height="244" ClipToBounds="False">
                                    <Border Height="150"
                                            VerticalAlignment="Top"
                                            Margin="0,28,0,0"
                                            BorderBrush="#C8D0DE"
                                            BorderThickness="1,0,1,0"
                                            IsHitTestVisible="False" />
                                    <ItemsControl ItemsSource="{Binding TrendAxisTicks}"
                                                  Height="150"
                                                  VerticalAlignment="Top"
                                                  Margin="0,28,0,0"
                                                  IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="0"
                                                      Y1="8"
                                                      X2="{Binding DataContext.TrendChartWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Y2="8"
                                                      Stroke="#DDE5F0"
                                                      StrokeThickness="1"
                                                      StrokeDashArray="4 4"
                                                      Opacity="0.78" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding TrendStats}" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="78"
                                                      Height="244"
                                                      ClipToBounds="False"
                                                      ToolTipService.Placement="Mouse">
                                                    <Grid.ToolTip>
                                                        <ToolTip Placement="Mouse"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <Border Background="White"
                                                                    BorderBrush="#DDE5F0"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="10,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Label}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#071344"
                                                                               Margin="0,0,0,6" />
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Tiếp nhận"
                                                                                   Foreground="#126BFF"
                                                                                   Margin="0,0,14,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding ReceivedCount}"
                                                                                   Foreground="#126BFF"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Đã giải quyết"
                                                                                   Foreground="#12A660"
                                                                                   Margin="0,0,14,0" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding ResolvedCount}"
                                                                                   Foreground="#12A660"
                                                                                   FontWeight="SemiBold" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip>
                                                    </Grid.ToolTip>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="178" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Canvas Grid.Row="0"
                                                            Height="150"
                                                            VerticalAlignment="Bottom"
                                                            ClipToBounds="False">
                                                        <Border Width="34"
                                                                Height="{Binding ReceivedHeight}"
                                                                Canvas.Left="22"
                                                                Canvas.Top="{Binding ReceivedBarTop}"
                                                                CornerRadius="4,4,0,0"
                                                                Loaded="VerticalBar_Loaded"
                                                                RenderTransformOrigin="0.5,1">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#2F73FF" Offset="0" />
                                                                    <GradientStop Color="#82B4FF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 Canvas.Left="34"
                                                                 Canvas.Top="{Binding ResolvedPointTop}"
                                                                 Fill="White"
                                                                 Stroke="#12A660"
                                                                 StrokeThickness="2.8" />
                                                    </Canvas>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Label}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#071344"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Canvas Height="150"
                                            VerticalAlignment="Top"
                                            Margin="0,28,0,0"
                                            IsHitTestVisible="False"
                                            ClipToBounds="False">
                                        <Polyline x:Name="TrendLinePath"
                                                  Points="{Binding TrendLinePoints}"
                                                  Stroke="#12A660"
                                                  StrokeThickness="3"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Loaded="TrendLinePath_Loaded"
                                                  RenderTransformOrigin="0,0.5">
                                            <Polyline.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Polyline.RenderTransform>
                                        </Polyline>
                                    </Canvas>
                                    </Grid>
                                </ScrollViewer>
                                <Canvas Grid.Column="2"
                                        Height="150"
                                        VerticalAlignment="Top"
                                        Margin="6,28,0,0"
                                        IsHitTestVisible="False">
                                    <ItemsControl ItemsSource="{Binding TrendAxisTicks}"
                                                  Width="32"
                                                  Height="150">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"
                                                           Width="32"
                                                           FontSize="12"
                                                           Foreground="#12A660" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,38,0">
                                <Border Width="18" Height="12" CornerRadius="3" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2F73FF" Offset="0" />
                                            <GradientStop Color="#82B4FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Tổng số hồ sơ tiếp nhận" Foreground="#18264A" FontSize="13" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Canvas Width="26" Height="14" VerticalAlignment="Center">
                                    <Line X1="0"
                                          Y1="7"
                                          X2="26"
                                          Y2="7"
                                          Stroke="#12A660"
                                          StrokeThickness="2.6"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round" />
                                    <Ellipse Width="8" Height="8" Canvas.Left="9" Canvas.Top="3" Fill="White" Stroke="#12A660" StrokeThickness="2.4" />
                                </Canvas>
                                <TextBlock Text="Số hồ sơ đã giải quyết" Foreground="#18264A" FontSize="13" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
