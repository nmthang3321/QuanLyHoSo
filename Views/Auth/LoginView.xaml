<UserControl x:Class="QuanLyHoSo.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Width="420"
                Padding="28"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ĐĂNG NHẬP" Style="{StaticResource PageTitleText}" TextAlignment="Center" />
                <TextBlock Text="Quản lý hồ sơ theo tài khoản và phân quyền"
                           Style="{StaticResource MutedText}"
                           TextAlignment="Center"
                           Margin="0,4,0,24" />

                <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabelText}" />
                <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <TextBlock Text="Mật khẩu" Style="{StaticResource FieldLabelText}" />
                <PasswordBox x:Name="PasswordInput"
                             Height="34"
                             Padding="10,6"
                             BorderBrush="{StaticResource LineBrush}"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             Margin="0,0,0,12" />

                <Border Background="#FFF4F4"
                        BorderBrush="#FFD2D2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" />
                </Border>

                <Button Style="{StaticResource PrimaryButton}"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SignInCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="Đăng nhập" Foreground="White" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Tài khoản mặc định: admin / admin123"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
