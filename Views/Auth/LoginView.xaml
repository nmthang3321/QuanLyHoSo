<UserControl x:Class="QuanLyHoSo.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="LoginView_Loaded">
    <UserControl.Resources>
        <Style x:Key="LoginFieldBorder" TargetType="Border">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="#D5DEEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="LoginInputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginIconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#65739D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF4FF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DFEAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0051E8" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#0045C7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="17" />
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/LoginBackground.jpg" Stretch="UniformToFill"
                            AlignmentX="Center" AlignmentY="Center" />
            </Border.Background>
        </Border>
        <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B30A2038" Offset="0" />
                    <GradientStop Color="#A60A2038" Offset="0.28" />
                    <GradientStop Color="#6B0A2038" Offset="0.48" />
                    <GradientStop Color="#08032960" Offset="0.7" />
                    <GradientStop Color="#18032960" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.ColumnSpan="2" Height="100" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00052140" Offset="0" />
                    <GradientStop Color="#99052140" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Grid.Column="0">
            <Grid MaxWidth="510" Margin="40,40,28,28" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="LoginIntroduction" Margin="0,0,0,64" VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>
                    <Border Width="72" Height="72" Background="White" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/Assets/icons8-id-card-80.png" Stretch="Uniform" />
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="PHẦN MỀM" Foreground="#D5E8FF" FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Foreground="White" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="44">
                        <Run Text="Quản lý, tiếp nhận" /><LineBreak />
                        <Run Text="và xử lý hồ sơ" />
                    </TextBlock>
                    <TextBlock Text="Tỉnh An Giang" Foreground="#E2EDFF" FontSize="22"
                               TextAlignment="Center" Margin="0,10,0,0" />
                    <Border Width="48" Height="3" Background="#81B5FF"
                            HorizontalAlignment="Center" Margin="0,24,0,20" />
                    <TextBlock Text="Vì người dân" Foreground="White" FontSize="19" TextAlignment="Center"
                               FontFamily="Segoe UI" FontStyle="Italic" FontWeight="Normal" />
                    <TextBlock Text="Vì một An Giang phát triển" Foreground="White" FontSize="19" TextAlignment="Center"
                               FontStyle="Italic" FontWeight="Normal" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                        <!-- Google Material Symbols Outlined: psychiatry, 24px / weight 400 / fill 0.
                             https://github.com/google/material-design-icons (Apache-2.0) -->
                        <Path Width="20" Height="20" Stretch="Uniform" Fill="#99DFFF"
                              Margin="0,0,9,0" VerticalAlignment="Center"
                              Data="M440-120v-319q-64 0-123-24.5T213-533q-45-45-69-104t-24-123v-80h80q63 0 122 24.5T426-746q31 31 51.5 68t31.5 79q5-7 11-13.5t13-13.5q45-45 104-69.5T760-720h80v80q0 64-24.5 123T746-413q-45 45-103.5 69T520-320v200h-80Zm0-400q0-48-18.5-91.5T369-689q-34-34-77.5-52.5T200-760q0 48 18 92t52 78q34 34 78 52t92 18Zm80 120q48 0 91.5-18t77.5-52q34-34 52.5-78t18.5-92q-48 0-92 18.5T590-569q-34 34-52 77.5T520-400Zm0 0Zm-80-120Z" />
                        <TextBlock Text="Minh bạch" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#99DFFF" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="Hiệu quả" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#99DFFF" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="Phục vụ người dân" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,12,42,12" VerticalContentAlignment="Center">
            <Border x:Name="LoginForm" MaxWidth="510" Padding="32,24" Background="#EDF8FCFF"
                    BorderBrush="#E0EAF5" BorderThickness="1" CornerRadius="14"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#092947" BlurRadius="30" ShadowDepth="8" Opacity="0.18" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Đăng nhập"
                               Foreground="#172B4D"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextAlignment="Left"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Vui lòng đăng nhập để sử dụng hệ thống"
                               Foreground="#5C6B91"
                               FontSize="15"
                               TextAlignment="Left"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />

                    <TextBlock Text="T&#x00EA;n &#x0111;&#x0103;ng nh&#x1EAD;p"
                               Foreground="#172B4D"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Border Style="{StaticResource LoginFieldBorder}"
                            MouseEnter="LoginField_MouseChanged"
                            MouseLeave="LoginField_MouseChanged"
                            IsKeyboardFocusWithinChanged="LoginField_FocusChanged"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#65739D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="UserNameInput"
                                         Style="{StaticResource LoginInputTextBox}"
                                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="UserNameInput_FocusChanged"
                                         LostKeyboardFocus="UserNameInput_FocusChanged"
                                         TextChanged="UserNameInput_TextChanged" />
                                <TextBlock x:Name="UserNamePlaceholder"
                                           Text="Nh&#x1EAD;p t&#x00EA;n &#x0111;&#x0103;ng nh&#x1EAD;p"
                                           Foreground="#65739D"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="M&#x1EAD;t kh&#x1EA9;u"
                               Foreground="#172B4D"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Border Style="{StaticResource LoginFieldBorder}"
                            MouseEnter="LoginField_MouseChanged"
                            MouseLeave="LoginField_MouseChanged"
                            IsKeyboardFocusWithinChanged="LoginField_FocusChanged"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE785;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#65739D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1">
                                <PasswordBox x:Name="PasswordInput"
                                             Style="{StaticResource LoginPasswordBox}"
                                             PasswordChanged="PasswordInput_PasswordChanged"
                                             KeyDown="PasswordInput_KeyDown"
                                             GotKeyboardFocus="PasswordField_FocusChanged"
                                             LostKeyboardFocus="PasswordField_FocusChanged" />
                                <TextBox x:Name="PasswordVisibleInput"
                                         Style="{StaticResource LoginInputTextBox}"
                                         Visibility="Collapsed"
                                         TextChanged="PasswordVisibleInput_TextChanged"
                                         KeyDown="PasswordInput_KeyDown"
                                         GotKeyboardFocus="PasswordField_FocusChanged"
                                         LostKeyboardFocus="PasswordField_FocusChanged" />
                                <TextBlock x:Name="PasswordPlaceholder"
                                           Text="Nh&#x1EAD;p m&#x1EAD;t kh&#x1EA9;u"
                                           Foreground="#65739D"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="2"
                                    Style="{StaticResource LoginIconButton}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="TogglePasswordVisibility_Click"
                                    ToolTip="Hi&#x1EC7;n m&#x1EAD;t kh&#x1EA9;u">
                                <Grid Width="20" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,8 C4,3.5 7,2 10,2 C13,2 16,3.5 19,8 C16,12.5 13,14 10,14 C7,14 4,12.5 1,8 Z" />
                                    <Ellipse Width="5"
                                             Height="5"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.8"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path x:Name="TogglePasswordSlash"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M3,14 L17,2" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#FFF4F4"
                            BorderBrush="#FFD2D2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,18"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#B00020"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="Ghi nh&#x1EDB; &#x0111;&#x0103;ng nh&#x1EAD;p"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="#172B4D"
                                  FontSize="13"
                                  FontWeight="Normal"
                                  VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource LoginTextButton}"
                                Command="{Binding ForgotPasswordCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <TextBlock Text="Quên mật khẩu?" FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource LoginPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding SignInCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8D7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="20"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#x0110;&#x0103;ng nh&#x1EAD;p"
                                       Foreground="White"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="#E1E9F3" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                        <Border Background="#EFF7FF" Padding="16" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Google Material Symbols Outlined: verified_user, 24px / weight 400 / fill 0.
                                     https://github.com/google/material-design-icons (Apache-2.0) -->
                                <Path Width="26" Height="32" Stretch="Uniform" Fill="#2173B8"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Data="m438-338 226-226-57-57-169 169-84-84-57 57 141 141Zm42 258q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244q0 152-90.5 276.5T480-80Zm0-84q104-33 172-132t68-220v-189l-240-90-240 90v189q0 121 68 220t172 132Zm0-316Z" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hệ thống hồ sơ tỉnh An Giang" Foreground="#2164A0"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Tiếp nhận · Theo dõi · Xử lý tập trung"
                                               Foreground="#637B95" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Text="Phiên bản 1.0.0"
                       Foreground="White"
                       FontSize="13"
                       HorizontalAlignment="Right"
                       Margin="0,0,42,28" />
        </Grid>
    </Grid>
</UserControl>
