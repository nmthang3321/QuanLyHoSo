<UserControl x:Class="QuanLyHoSo.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="LoginView_Loaded">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="LoginBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#003F91" Offset="0" />
            <GradientStop Color="#0067C8" Offset="0.54" />
            <GradientStop Color="#0B5CFF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="LoginInputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="54" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="54" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginIconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#65739D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF4FF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0051E8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0051E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0045C7" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0045C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F4F8FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*" />
            <ColumnDefinition Width="54*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True">
            <Image Source="/Assets/LoginBackground.png"
                   Stretch="UniformToFill"
                   Opacity="1">
                <Image.Effect>
                    <BlurEffect Radius="0" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="{StaticResource LoginBlueBrush}" Opacity="0.24" />
            <Rectangle Opacity="0.1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#001746" Offset="0" />
                        <GradientStop Color="#004EA8" Offset="0.56" />
                        <GradientStop Color="#0B5CFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="28,-300,128,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
                <Viewbox MaxWidth="460"
                         Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center">
                    <StackPanel Width="460">
                        <Border Width="104"
                                Height="124"
                                Background="White">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/Assets/icons8-id-card-80.png"
                                            Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>

                        <TextBlock Text="PH&#x1EA6;N M&#x1EC0;M"
                                   Foreground="White"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="QU&#x1EA2;N L&#x00DD; H&#x1ED2; S&#x01A0;"
                                   Foreground="White"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="Gi&#x1EA3;i ph&#x00E1;p qu&#x1EA3;n l&#x00FD; th&#x00F4;ng tin h&#x1ED3; s&#x01A1;"
                                   Foreground="White"
                                   FontSize="20"
                                   TextAlignment="Center"
                                   Margin="0,30,0,0" />
                        <TextBlock Text="khu v&#x1EF1;c t&#x1EC9;nh An Giang"
                                   Foreground="White"
                                   FontSize="20"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Viewbox>
            </Grid>

            <Ellipse Width="360"
                     Height="1080"
                     Fill="#E9EEF8"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,-216,0" />
            <Ellipse Width="330"
                     Height="1060"
                     Fill="#F8FBFF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,-220,0" />
        </Grid>

        <Grid Grid.Column="1" Background="#F8FBFF">
            <Border Width="520"
                    Padding="30,34"
                    Background="#FAFFFFFF"
                    BorderBrush="#D8E2F3"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="8"
                                      Direction="270"
                                      Color="#3B5D8F"
                                      Opacity="0.16" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="&#x0110;&#x0102;NG NH&#x1EAC;P"
                               Foreground="#071D68"
                               FontSize="28"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Margin="0,16,0,8" />
                    <TextBlock Text="Vui l&#x00F2;ng &#x0111;&#x0103;ng nh&#x1EAD;p &#x0111;&#x1EC3; ti&#x1EBF;p t&#x1EE5;c"
                               Foreground="#5C6B91"
                               FontSize="17"
                               TextAlignment="Center"
                               Margin="0,0,0,48" />

                    <TextBlock Text="T&#x00EA;n &#x0111;&#x0103;ng nh&#x1EAD;p"
                               Foreground="#071D68"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Border Height="56"
                            Background="White"
                            BorderBrush="#BFCBE4"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="#65739D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="UserNameInput"
                                         Style="{StaticResource LoginInputTextBox}"
                                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="UserNameInput_FocusChanged"
                                         LostKeyboardFocus="UserNameInput_FocusChanged"
                                         TextChanged="UserNameInput_TextChanged" />
                                <TextBlock x:Name="UserNamePlaceholder"
                                           Text="Nh&#x1EAD;p t&#x00EA;n &#x0111;&#x0103;ng nh&#x1EAD;p"
                                           Foreground="#65739D"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="M&#x1EAD;t kh&#x1EA9;u"
                               Foreground="#071D68"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Border Height="56"
                            Background="White"
                            BorderBrush="#BFCBE4"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE785;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="21"
                                       Foreground="#65739D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1">
                                <PasswordBox x:Name="PasswordInput"
                                             Style="{StaticResource LoginPasswordBox}"
                                             PasswordChanged="PasswordInput_PasswordChanged"
                                             KeyDown="PasswordInput_KeyDown"
                                             GotKeyboardFocus="PasswordField_FocusChanged"
                                             LostKeyboardFocus="PasswordField_FocusChanged" />
                                <TextBox x:Name="PasswordVisibleInput"
                                         Style="{StaticResource LoginInputTextBox}"
                                         Visibility="Collapsed"
                                         TextChanged="PasswordVisibleInput_TextChanged"
                                         KeyDown="PasswordInput_KeyDown"
                                         GotKeyboardFocus="PasswordField_FocusChanged"
                                         LostKeyboardFocus="PasswordField_FocusChanged" />
                                <TextBlock x:Name="PasswordPlaceholder"
                                           Text="Nh&#x1EAD;p m&#x1EAD;t kh&#x1EA9;u"
                                           Foreground="#65739D"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="TogglePasswordButton"
                                    Grid.Column="2"
                                    Style="{StaticResource LoginIconButton}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="TogglePasswordVisibility_Click"
                                    ToolTip="Hi&#x1EC7;n m&#x1EAD;t kh&#x1EA9;u">
                                <Grid Width="20" Height="16">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,8 C4,3.5 7,2 10,2 C13,2 16,3.5 19,8 C16,12.5 13,14 10,14 C7,14 4,12.5 1,8 Z" />
                                    <Ellipse Width="5"
                                             Height="5"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.8"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path x:Name="TogglePasswordSlash"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M3,14 L17,2" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="#FFF4F4"
                            BorderBrush="#FFD2D2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,18"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#B00020"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,0,0,52">
                        <CheckBox Content="Ghi nh&#x1EDB; &#x0111;&#x0103;ng nh&#x1EAD;p"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Foreground="#071D68"
                                  FontSize="15"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center" />
                        <Button Content="Qu&#x00EA;n m&#x1EAD;t kh&#x1EA9;u?"
                                Style="{StaticResource LoginTextButton}"
                                Command="{Binding ForgotPasswordCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Button Style="{StaticResource LoginPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding SignInCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8D7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="20"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#x0110;&#x0103;ng nh&#x1EAD;p"
                                       Foreground="White"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="v1.0.0"
                       Foreground="#5C6B91"
                       FontSize="13"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,24,18" />
        </Grid>
    </Grid>
</UserControl>
