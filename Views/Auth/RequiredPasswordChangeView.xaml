<UserControl x:Class="QuanLyHoSo.Views.Auth.RequiredPasswordChangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="RequiredPasswordChangeView_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2173B8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A619D" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#144C7D" />
        <Style x:Key="PasswordField" TargetType="Border">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="#D5DEEB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#172B4D" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChangeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="/Assets/LoginBackground.jpg" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B30A2038" Offset="0" />
                    <GradientStop Color="#A60A2038" Offset="0.28" />
                    <GradientStop Color="#6B0A2038" Offset="0.48" />
                    <GradientStop Color="#08032960" Offset="0.7" />
                    <GradientStop Color="#18032960" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="100" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00052140" Offset="0" />
                    <GradientStop Color="#99052140" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid MaxWidth="510" Margin="40,40,28,28" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,64" VerticalAlignment="Center">
                        <Border Width="72" Height="72" Background="White" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/Assets/icons8-id-card-80.png" Stretch="Uniform" />
                            </Border.OpacityMask>
                        </Border>
                        <TextBlock Text="PHẦN MỀM" Foreground="#D5E8FF" FontSize="14" FontWeight="SemiBold"
                                   TextAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Foreground="White" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="Center" LineHeight="44">
                            <Run Text="Quản lý, tiếp nhận" /><LineBreak />
                            <Run Text="và xử lý hồ sơ" />
                        </TextBlock>
                        <TextBlock Text="Tỉnh An Giang" Foreground="#E2EDFF" FontSize="22"
                                   TextAlignment="Center" Margin="0,10,0,0" />
                        <Border Width="48" Height="3" Background="#81B5FF"
                                HorizontalAlignment="Center" Margin="0,24,0,20" />
                        <TextBlock Text="Vì người dân" Foreground="White" FontSize="19" TextAlignment="Center"
                                   FontFamily="Segoe UI" FontStyle="Italic" FontWeight="Normal" />
                        <TextBlock Text="Vì một An Giang phát triển" Foreground="White" FontSize="19" TextAlignment="Center"
                                   FontStyle="Italic" FontWeight="Normal" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="#99DFFF"
                                  Margin="0,0,9,0" VerticalAlignment="Center"
                                  Data="M440-120v-319q-64 0-123-24.5T213-533q-45-45-69-104t-24-123v-80h80q63 0 122 24.5T426-746q31 31 51.5 68t31.5 79q5-7 11-13.5t13-13.5q45-45 104-69.5T760-720h80v80q0 64-24.5 123T746-413q-45 45-103.5 69T520-320v200h-80Zm0-400q0-48-18.5-91.5T369-689q-34-34-77.5-52.5T200-760q0 48 18 92t52 78q34 34 78 52t92 18Zm80 120q48 0 91.5-18t77.5-52q34-34 52.5-78t18.5-92q-48 0-92 18.5T590-569q-34 34-52 77.5T520-400Zm0 0Zm-80-120Z" />
                            <TextBlock Text="Minh bạch" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#99DFFF" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hiệu quả" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#99DFFF" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="Phục vụ người dân" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,12,42,12" VerticalContentAlignment="Center">
                <Border MaxWidth="510" Padding="32,24" Background="#EDF8FCFF"
                        BorderBrush="#E0EAF5" BorderThickness="1" CornerRadius="14"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#092947" BlurRadius="30" ShadowDepth="8" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Đổi mật khẩu" Foreground="#172B4D" FontSize="32" FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Tài khoản cần đổi mật khẩu trước khi truy cập hệ thống."
                                   Foreground="#5C6B91" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20" />

                        <Border Background="#EFF5FF" CornerRadius="6" Padding="12,9" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding UserDisplayText}" Foreground="#31527A" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Mật khẩu hiện tại" Foreground="#172B4D"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Style="{StaticResource PasswordField}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#65739D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <PasswordBox x:Name="CurrentPasswordInput" Grid.Column="1" Style="{StaticResource PasswordInput}"
                                             PasswordChanged="PasswordInput_PasswordChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Mật khẩu mới" Foreground="#172B4D" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Style="{StaticResource PasswordField}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#65739D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <PasswordBox x:Name="NewPasswordInput" Grid.Column="1" Style="{StaticResource PasswordInput}"
                                             PasswordChanged="PasswordInput_PasswordChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Nhập lại mật khẩu mới" Foreground="#172B4D" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Border Style="{StaticResource PasswordField}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#65739D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <PasswordBox x:Name="ConfirmPasswordInput" Grid.Column="1" Style="{StaticResource PasswordInput}"
                                             PasswordChanged="PasswordInput_PasswordChanged" KeyDown="ConfirmPasswordInput_KeyDown" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Mật khẩu mới cần tối thiểu 6 ký tự và khác mật khẩu tạm."
                                   Foreground="#65739D" FontSize="12" Margin="0,0,0,14" />
                        <Border Background="#FFF4F4" BorderBrush="#FFD2D2" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" />
                        </Border>

                        <Button Style="{StaticResource ChangeButton}" Command="{Binding ChangePasswordCommand}" IsDefault="True">
                            <TextBlock Text="Đổi mật khẩu và tiếp tục" Foreground="White" FontSize="15" />
                        </Button>
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Center" Height="34" Margin="0,8,0,0">
                            <TextBlock Text="Quay lại đăng nhập"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
