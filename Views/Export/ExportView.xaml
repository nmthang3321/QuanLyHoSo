<UserControl x:Class="QuanLyHoSo.Views.Export.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:QuanLyHoSo.Presentation">
    <UserControl.Resources>
        <presentation:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <Style x:Key="ExportFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ExportCalendarDayButton" TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ExportCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#7FAEFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ExportCalendarDayButton}" />
        </Style>

        <Style x:Key="ExportDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#7FAEFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="FirstDayOfWeek" Value="Monday" />
            <Setter Property="CalendarStyle" Value="{StaticResource ExportCalendarStyle}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="XUẤT DỮ LIỆU" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Trích xuất dữ liệu hồ sơ theo nhu cầu" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Style="{StaticResource CardBorder}" Padding="12" Width="390">
                    <TextBlock Text="Dữ liệu được xuất đúng theo bộ lọc đang chọn. Hỗ trợ Excel (.xlsx) và CSV (.csv)." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18">
                <StackPanel>
                    <TextBlock Text="1. CHỌN BỘ LỌC DỮ LIỆU" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,14,14">
                            <TextBlock Text="Từ ngày" Style="{StaticResource ExportFilterLabel}" />
                            <DatePicker Style="{StaticResource ExportDatePickerStyle}"
                                        SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Language="vi-VN" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,14">
                            <TextBlock Text="Đến ngày" Style="{StaticResource ExportFilterLabel}" />
                            <DatePicker Style="{StaticResource ExportDatePickerStyle}"
                                        SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Language="vi-VN" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,14,14">
                            <TextBlock Text="Trạng thái hồ sơ" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,14,14">
                            <TextBlock Text="Loại vụ việc" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding CaseTypes}" SelectedItem="{Binding SelectedCaseType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,0,14">
                            <TextBlock Text="Lĩnh vực" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,14,14">
                            <TextBlock Text="Địa bàn" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,14">
                            <TextBlock Text="Người xử lý" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding Processors}" SelectedItem="{Binding SelectedProcessor, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,14,14">
                            <TextBlock Text="Từ khóa tìm kiếm" Style="{StaticResource ExportFilterLabel}" />
                            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,14">
                            <TextBlock Text="Sắp xếp theo" Style="{StaticResource ExportFilterLabel}" />
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" Content="Đặt lại" Margin="0,0,12,0" Command="{Binding ResetFilterCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Xem dữ liệu" Command="{Binding ApplyFilterCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="2. CHỌN ĐỊNH DẠNG XUẤT" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />
                        <RadioButton IsChecked="{Binding IsExcelFormat, Mode=TwoWay}" GroupName="ExportFormat" Margin="0,0,0,8">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="22" CornerRadius="3" Background="#16864B" Margin="0,0,8,0">
                                        <TextBlock Text="XLS" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Excel (.xlsx)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                        <TextBlock Text="Phù hợp để xem và phân tích dữ liệu" Style="{StaticResource MutedText}" Margin="22,0,0,14" />
                        <RadioButton IsChecked="{Binding IsCsvFormat, Mode=TwoWay}" GroupName="ExportFormat" Margin="0,0,0,8">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="22" CornerRadius="3" Background="#2C9C8A" Margin="0,0,8,0">
                                        <TextBlock Text="CSV" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="CSV (.csv)" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                        <TextBlock Text="Phù hợp để xử lý dữ liệu hàng loạt" Style="{StaticResource MutedText}" Margin="22,0,0,18" />
                        <CheckBox Content="Xuất kèm tiêu đề cột" IsChecked="{Binding IncludeHeaderRow, Mode=TwoWay}" Margin="0,0,0,8" />
                        <TextBlock Text="Cột dữ liệu" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <Border Background="#F8FAFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,18">
                            <UniformGrid Columns="2">
                                <CheckBox Content="STT" IsChecked="{Binding ShowIndexColumn, Mode=TwoWay}" Margin="0,0,8,8" />
                                <CheckBox Content="Mã hồ sơ" IsChecked="{Binding ShowRecordCodeColumn, Mode=TwoWay}" Margin="0,0,0,8" />
                                <CheckBox Content="Ngày tiếp nhận" IsChecked="{Binding ShowReceivedDateColumn, Mode=TwoWay}" Margin="0,0,8,8" />
                                <CheckBox Content="Người gửi đơn" IsChecked="{Binding ShowSenderNameColumn, Mode=TwoWay}" Margin="0,0,0,8" />
                                <CheckBox Content="Địa bàn" IsChecked="{Binding ShowAreaColumn, Mode=TwoWay}" Margin="0,0,8,8" />
                                <CheckBox Content="Loại vụ việc" IsChecked="{Binding ShowCaseTypeColumn, Mode=TwoWay}" Margin="0,0,0,8" />
                                <CheckBox Content="Lĩnh vực" IsChecked="{Binding ShowFieldColumn, Mode=TwoWay}" Margin="0,0,8,0" />
                                <CheckBox Content="Trạng thái" IsChecked="{Binding ShowStatusColumn, Mode=TwoWay}" />
                            </UniformGrid>
                        </Border>
                        <Border Background="#F0F6FF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <TextBlock Text="Hệ thống sẽ xuất dữ liệu theo bộ lọc và các cột đã đánh dấu." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="3. XEM TRƯỚC DỮ LIỆU" Style="{StaticResource SectionTitleText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14" />
                        <Border Background="#F0F6FF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding TotalRecordsText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                        <DataGrid ItemsSource="{Binding PreviewRecords}" Height="246">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT"
                                                    Binding="{Binding Index}"
                                                    Width="55"
                                                    Visibility="{Binding Data.ShowIndexColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Mã hồ sơ"
                                                    Binding="{Binding RecordCode}"
                                                    Width="130"
                                                    Visibility="{Binding Data.ShowRecordCodeColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Ngày tiếp nhận"
                                                    Binding="{Binding ReceivedDate}"
                                                    Width="120"
                                                    Visibility="{Binding Data.ShowReceivedDateColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Người gửi đơn"
                                                    Binding="{Binding SenderName}"
                                                    Width="*"
                                                    Visibility="{Binding Data.ShowSenderNameColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Địa bàn"
                                                    Binding="{Binding AreaName}"
                                                    Width="110"
                                                    Visibility="{Binding Data.ShowAreaColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Loại vụ việc"
                                                    Binding="{Binding CaseType}"
                                                    Width="115"
                                                    Visibility="{Binding Data.ShowCaseTypeColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTextColumn Header="Lĩnh vực"
                                                    Binding="{Binding Field}"
                                                    Width="150"
                                                    Visibility="{Binding Data.ShowFieldColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridTemplateColumn Header="Trạng thái"
                                                        Width="132"
                                                        Visibility="{Binding Data.ShowStatusColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Height="22"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="{Binding ResultRangeText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Xuất dữ liệu" HorizontalAlignment="Right" MinWidth="170" Command="{Binding ExportCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

